-- live ESP preview: blocky R6-style avatar (reads NOTHING from the game)
local function w_preview(it, x, y, w, ap)
    local h = BASE_ROW.preview
    local t = utility.GetTime()

    draw.RectFilled(x, y, w, h, a({0.02,0.03,0.05,1}, ap), 6)
    for gy=1,4 do draw.Line(x, y+h-gy*20, x+w, y+h-gy*20, a(theme.line, ap*0.35), 1) end
    draw.Rect(x, y, w, h, a(theme.line, ap), 6, 1)
    tmid(x+8, y+4, 14, "live preview", a(theme.faint, ap), 9)
    local modelname = (ui.vals["bar_name"] and "Blossom") or "Model"
    tright(x+w-8, y+4, 14, "model: "..modelname, a(theme.sub, ap), 9)

    local cx = x + w*0.5
    local ground = y + h - 14
    local pose = ui.vals["pv_pose"] or 1
    local spin = ui.vals["pv_spin"]
    local sway = ui.vals["pv_sway"]
    local skin = ui.colors["_skin"] or {0.34,0.36,0.42,1}
    local skin_hi = mix(skin, {1,1,1,1}, 0.14)
    local skin_lo = mix(skin, {0,0,0,1}, 0.28)
    local face_col = mix(skin, {1,0.86,0.6,1}, 0.5)  -- head slightly warmer

    -- turntable: width multiplier + facing
    local ang = spin and (t*0.9) or 0.45
    local depth = math.cos(ang)
    local xw = 0.30 + 0.70*math.abs(depth)     -- box width scales with rotation
    local facing = depth>=0 and 1 or -1

    local bob  = sway and math.sin(t*2.0)*2 or 0
    local lean = sway and math.sin(t*1.3)*1.4 or 0
    local hx = cx + lean

    -- crouch / run
    local crouch = (pose==3) and 14 or 0
    local swing  = (pose==2) and math.sin(t*6)*7 or 0

    -- ---- blocky proportions (R6 feel) ----
    local head_w = 20*xw
    local head_h = 16
    local torso_w = 30*xw
    local torso_h = 34
    local arm_w = 9*xw
    local arm_h = 34
    local leg_w = 11*xw
    local leg_h = 34 - crouch

    -- helper: draw a shaded box (fill + right-side shade + top highlight + outline)
    local function box(bx, by, bw, bh, base)
        draw.RectFilled(bx, by, bw, bh, a(base, ap), 3)
        -- right third shaded for volume, side depends on facing
        local sh_x = facing>=0 and (bx+bw*0.62) or bx
        draw.RectFilled(sh_x, by, bw*0.38, bh, a(skin_lo, ap*0.55), 3)
        -- top highlight
        draw.RectFilled(bx, by, bw, bh*0.16, a(skin_hi, ap*0.5), 3)
        draw.Rect(bx, by, bw, bh, a({0,0,0,1}, ap*0.35), 3, 1)
    end

    -- floor shadow
    draw.CircleFilled(cx, ground+2, torso_w*0.55, a({0,0,0,1}, ap*0.4), 20)

    -- stack from the ground up
    local legY = ground - leg_h
    local torsoY = legY - torso_h
    local headY = torsoY - head_h

    -- legs (two boxes, run-swing offsets them)
    box(hx - leg_w - 1 - swing*xw, legY, leg_w, leg_h, skin)
    box(hx + 1 + swing*xw,         legY, leg_w, leg_h, skin)

    -- torso
    box(hx - torso_w*0.5, torsoY, torso_w, torso_h, skin)
    -- a strap detail across torso (cosmetic flavor, like the ref's rig)
    draw.Line(hx - torso_w*0.4, torsoY+3, hx + torso_w*0.4, torsoY+torso_h-5, a(skin_lo, ap*0.8), 2)

    -- arms (two boxes at torso sides, run-swing opposite legs)
    local armY = torsoY + swing*xw
    box(hx - torso_w*0.5 - arm_w - 1, armY, arm_w, arm_h, skin)
    box(hx + torso_w*0.5 + 1,         armY - swing*xw*2, arm_w, arm_h, skin)

    -- head (box) + simple face
    local hbx = hx - head_w*0.5
    box(hbx, headY, head_w, head_h, face_col)
    -- eyes + smile only when facing roughly forward
    if depth > -0.2 then
        local eo = head_w*0.22
        draw.CircleFilled(hx-eo, headY+head_h*0.42, 1.6, a({0.05,0.05,0.05,1}, ap), 10)
        draw.CircleFilled(hx+eo, headY+head_h*0.42, 1.6, a({0.05,0.05,0.05,1}, ap), 10)
        draw.Line(hx-eo, headY+head_h*0.72, hx+eo, headY+head_h*0.72, a({0.05,0.05,0.05,1}, ap*0.9), 1.4)
    end

    -- weapon: a small box held at the right hand
    if ui.vals["pv_weapon"] then
        local handx = hx + torso_w*0.5 + 1 + arm_w*0.5
        local handy = armY - swing*xw*2 + arm_h - 4
        local wl = 18*math.abs(xw)
        draw.RectFilled(handx, handy, wl*facing, 4, a({0.5,0.52,0.57,1}, ap), 1)
        draw.RectFilled(handx + (wl*0.4)*facing, handy+3, 3*facing, 6, a({0.5,0.52,0.57,1}, ap), 1)
    end

    -- ================= ESP overlay =================
    local on = ui.vals["esp_on"]
    if on then
        local col = ui.colors["_esp"] or theme.accent
        local pad2 = 8
        local boxx = hx - (torso_w*0.5 + arm_w + 1) - pad2
        local boxw = (torso_w + arm_w*2 + 2) + pad2*2
        local boxy = headY - 5
        local boxh = (ground - boxy) + 4

        if ui.vals["esp_box"] then
            local style = ui.vals["esp_style"] or 1
            local bc = a(col, ap)
            if style==3 then
                draw.RectFilled(boxx, boxy, boxw, boxh, raw(col, 0.12*ap), 2)
                draw.Rect(boxx, boxy, boxw, boxh, bc, 2, 1.4)
            elseif style==2 then
                local c=7
                draw.Line(boxx,boxy,boxx+c,boxy,bc,1.6); draw.Line(boxx,boxy,boxx,boxy+c,bc,1.6)
                draw.Line(boxx+boxw,boxy,boxx+boxw-c,boxy,bc,1.6); draw.Line(boxx+boxw,boxy,boxx+boxw,boxy+c,bc,1.6)
                draw.Line(boxx,boxy+boxh,boxx+c,boxy+boxh,bc,1.6); draw.Line(boxx,boxy+boxh,boxx,boxy+boxh-c,bc,1.6)
                draw.Line(boxx+boxw,boxy+boxh,boxx+boxw-c,boxy+boxh,bc,1.6); draw.Line(boxx+boxw,boxy+boxh,boxx+boxw,boxy+boxh-c,bc,1.6)
            elseif style==4 then
                draw.Rect(boxx, boxy, boxw, boxh, raw(col, 0.35*ap), 2, 1)
            else
                draw.Rect(boxx, boxy, boxw, boxh, bc, 2, 1.4)
            end
            draw.RectFilled(boxx-5, boxy, 3, boxh, a({0.1,0.1,0.12,1}, ap), 1)
            draw.RectFilled(boxx-5, boxy+boxh*0.22, 3, boxh*0.78, a({0.3,0.85,0.4,1}, ap), 1)
        end
        if ui.vals["esp_name"] then
            local nm = "Vithindhjd"
            local tw2 = tsize(nm, 11)
            draw.Text(hx-tw2*0.5, boxy-14, nm, a(col, ap), 11)
        end
        local distmax = ui.vals["esp_dist"] or 750
        local dt = math.floor(distmax*0.17).."m"
        local dtw = tsize(dt,10)
        draw.Text(hx-dtw*0.5, boxy+boxh+2, dt, a(theme.sub, ap), 10)
        if ui.vals["esp_snap"] then
            draw.Line(x+w*0.5, y+h-2, hx, boxy+boxh, a(col, ap*0.8), 1.4)
        end
    else
        local tw2 = tsize("ESP off · model live",11)
        draw.Text(x+(w-tw2)*0.5, y+16, "ESP off · model live", a(theme.faint, ap*0.8), 10)
    end

    return h
end

