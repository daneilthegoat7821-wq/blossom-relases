-- =============================================================
-- THREAT SCANNER — gun + armor inventory analysis
-- =============================================================
-- These keyword lists match Project Delta item names.
-- Any inventory item whose lowercase name contains one of these
-- strings is classified as a gun or armor piece.
-- Threat score = guns * 2 + armor * 3 (armor weighted higher since
-- it directly affects survivability more than extra guns).
GUN_KEYWORDS = {
    "rifle","pistol","smg","shotgun","sniper","carbine","gun","ak","m4",
    "mp5","uzi","mac","scar","aug","fal","svd","mosin","vss","sr25",
    "fn","g36","hk","spsh","tt33","makarov","vz61","socom","flaregun",
    "revolver","deagle","glock","colt","beretta","sig","fn57","bizon",
    "pp19","as_val","saiga","rpk","pkm","mg","lmg","dmr","marksman",
    "l96","awm","m24","remington","winchester","m1","garand","kar98",
    "dp28","bar","bren","sten","ppsh","mp40","mp38","grease","grease",
    "springfield","musket","crossbow","bow","launcher","rpg","gl",
}
ARMOR_KEYWORDS = {
    "helmet","vest","armor","armour","plate","chestrig","carrier",
    "bodyarmor","tacvest","juggernaut","shield","protec","kevlar",
    "ballistic","combat","military","heavy","medium","light.*armor",
    "titanshield","hspv","reapir",
}

-- THREAT_CACHE, THREAT_LABELS, THREAT_COLORS declared above near hud_panel
THREAT_STAMP = 0  -- last full scan time

local function classify_inv(inventory)
    local guns, armor = 0, 0
    for _, item in ipairs(inventory) do
        local il = item:lower()
        for _, kw in ipairs(GUN_KEYWORDS) do
            if il:find(kw, 1, true) then guns = guns + 1; break end
        end
        for _, kw in ipairs(ARMOR_KEYWORDS) do
            if il:find(kw, 1, true) then armor = armor + 1; break end
        end
    end
    return guns, armor
end

local function threat_level(guns, armor)
    -- Score: each gun = 2pts, each armor = 3pts
    -- Level: 0=None, 1=Low, 2=Medium, 3=High, 4=Extreme
    local score = guns * 2 + armor * 3
    local level
    if score == 0 then level = 0
    elseif score <= 3 then level = 1
    elseif score <= 7 then level = 2
    elseif score <= 12 then level = 3
    else level = 4 end
    return score, level
end

-- THREAT_LABELS, THREAT_COLORS, THREAT_CACHE defined above near hud_panel

local function update_threat_cache()
    -- Clear stale threat cache entries
    if cached_players and #cached_players > 0 then
        local alive2={}; for _,d in ipairs(cached_players) do if d.entity then alive2[d.entity.Name]=true end end
        for k in pairs(THREAT_CACHE) do if not alive2[k] then THREAT_CACHE[k]=nil end end
        for k in pairs(ESP_FOOTPRINTS) do if not alive2[k] then ESP_FOOTPRINTS[k]=nil end end
    end
    for _, d in ipairs(cached_players) do
        local p = d.entity
        if p and p.IsValid and p.IsAlive and not p.IsLocal then
            local guns, armor = classify_inv(d.inventory)
            local score, level = threat_level(guns, armor)
            THREAT_CACHE[p.Name] = {
                score=score, guns=guns, armor=armor,
                level=level, name=p.Name, entity=p
            }
        end
    end
    -- Update hud.status with the highest-threat nearby enemy
    if hud and hud.status then
        local me = entity.GetLocalPlayer()
        local mpos = me and me.Position
        local best = nil
        local best_score = -1
        for name, tc in pairs(THREAT_CACHE) do
            local p = tc.entity
            if p and p.IsValid and p.IsAlive then
                local pos = p.Position
                local dist = 99999
                if pos and mpos then
                    local dx=pos.X-mpos.X local dy=pos.Y-mpos.Y local dz=pos.Z-mpos.Z
                    dist = math.sqrt(dx*dx+dy*dy+dz*dz)
                end
                -- Prioritize by threat score, tiebreak by distance
                local priority = tc.score * 1000 - dist
                if priority > best_score then
                    best_score = priority
                    best = {tc=tc, dist=dist}
                end
            end
        end
        if best then
            local tc = best.tc
            local dist_m = math.floor(best.dist * 0.28)
            local label = THREAT_LABELS[tc.level+1] or "?"
            hud.status.player = tc.name
            hud.status.threat_level = tc.level
            hud.status.items = {
                string.format("Threat:  %s (score %d)", label, tc.score),
                string.format("Guns:    %d", tc.guns),
                string.format("Armor:   %d", tc.armor),
                string.format("Dist:    %dm", dist_m),
            }
        else
            hud.status.player = "No enemies"
            hud.status.threat_level = 0
            hud.status.items = {"Scanning..."}
        end
    end
end

