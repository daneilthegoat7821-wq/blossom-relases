-- edge-triggered typing while the search box is focused
local function search_typing()
    if not ui.search_focus then return end
    -- letters A-Z
    for vk=0x41,0x5A do
        local down = input.IsKeyDown(vk)
        if down and not ui.key_edge[vk] then
            ui.search = ui.search .. string.char(vk+32) -- lowercase
        end
        ui.key_edge[vk]=down
    end
    -- digits 0-9
    for vk=0x30,0x39 do
        local down = input.IsKeyDown(vk)
        if down and not ui.key_edge[vk] then ui.search = ui.search .. string.char(vk) end
        ui.key_edge[vk]=down
    end
    -- space
    local sp = input.IsKeyDown(0x20)
    if sp and not ui.key_edge[0x20] and #ui.search>0 then ui.search=ui.search.." " end
    ui.key_edge[0x20]=sp
    -- backspace
    local bk = input.IsKeyDown(0x08)
    if bk and not ui.key_edge[0x08] then ui.search=ui.search:sub(1,#ui.search-1) end
    ui.key_edge[0x08]=bk
    -- escape clears + unfocuses
    if input.IsKeyDown(0x1B) then ui.search=""; ui.search_focus=false end
end

-- collect matching items with their location breadcrumb
local function search_matches(q)
    q = q:lower()
    local out = {}
    for ti, tab in ipairs(tabs) do
        for _, g in ipairs(tab.groups) do
            for _, it in ipairs(g.items) do
                local label = it.label or it.text
                if label then
                    local hay = label:lower()
                    -- also match group name and tab name so "esp" -> Player ESP etc.
                    if hay:find(q,1,true) or g.name:lower():find(q,1,true) then
                        out[#out+1] = { it=it, tab=tab.name, ti=ti, group=g.name }
                    end
                end
            end
        end
    end
    return out
end

-- render search results as one flat scrollable column of matched controls
local function draw_search_results(t, q)
    local cx=ui.x+ui.railw+theme.pad
    local cy=ui.y+theme.pad+34
    local cw=ui.w-ui.railw-theme.pad*2-8
    local ch=ui.h-theme.pad*2-34
    local matches = search_matches(q)
    local scroll = ui.scroll["_search"] or 0

    if #matches==0 then
        tmid(cx, cy+20, 20, "No matches for \""..q.."\"", a(theme.sub,1), 13)
        tmid(cx, cy+42, 16, "try: aimbot · esp · fov · fly · chams", a(theme.faint,1), 11)
        return 0
    end

    local colw = cw
    local iy = cy - scroll
    local last_group = nil
    for _, m in ipairs(matches) do
        local it = m.it
        local ih = row_h(it)
        -- group/tab breadcrumb header when the group changes
        local key = m.tab.."/"..m.group
        if key ~= last_group then
            last_group = key
            if iy>=cy-30 and iy<=cy+ch then
                tmid(cx, iy, 20, m.tab.."  ›  "..m.group, a(theme.accent,1), 11)
            end
            iy = iy + 22
        end
        if iy+ih>cy-4 and iy<cy+ch+4 then
            draw.RectFilled(cx, iy-3, colw, ih+2, a(theme.panel, 0.5), 6)
            W[it.t](it, cx+12, iy, colw-24, 1)
        end
        iy = iy + ih + 6
    end
    local total = (iy + scroll) - cy
    -- scrollbar
    if total>ch then
        local BAR_W = 8
        local trx=ui.x+ui.w-BAR_W-4
        local maxs=total-ch
        local thumb=math.max(36,ch*(ch/total))
        local thy=cy+(ch-thumb)*(scroll/maxs)
        draw.RectFilled(trx,cy,BAR_W,ch, a(theme.rail,0.4),4)
        local hot=inside(trx-4,thy,BAR_W+8,thumb) and not ui.popup and not ui.picker
        local hv=approach("srch_scr_hv", hot and 1 or 0, 14)
        draw.RectFilled(trx,thy,BAR_W,thumb, a(mix(theme.accent,theme.accent2,hv),0.65+hv*0.35),4)
        if hot and ui.mouse.clicked and not ui.drag then
            ui.drag={kind="searchscroll",oy=ui.mouse.y-thy,ty=cy,th=ch,thumb=thumb,max=maxs}; ui.mouse.clicked=false
        end
        if ui.drag and ui.drag.kind=="searchscroll" then
            local d=ui.drag
            ui.scroll["_search"]=clamp((ui.mouse.y-d.oy-d.ty)/(d.th-d.thumb),0,1)*d.max
        end
    else ui.scroll["_search"]=0 end
    return total
end

local function draw_content(t)
    local cx=ui.x+ui.railw+theme.pad
    local cw=ui.w-ui.railw-theme.pad*2-8
    local sy=ui.y+12
    local has_q = #ui.search>0

    -- breadcrumb (also the window drag handle)
    if has_q then
        draw.Text(cx,sy,"search", a(theme.text,0.9),12)
        draw.Text(cx+tsize("search",12)+8, sy+1, "· results", a(theme.faint,1),10)
    else
        draw.Text(cx,sy, string.lower(tabs[ui.tab].name), a(theme.text,0.9),12)
        draw.Text(cx+tsize(string.lower(tabs[ui.tab].name),12)+8, sy+1, "· "..#tabs[ui.tab].groups.." modules", a(theme.faint,1),10)
    end
    if inside(cx,sy-4,cw-230,22) and ui.mouse.clicked and not ui.drag and not ui.popup and not ui.picker then
        ui.drag={kind="window",ox=ui.mouse.x-ui.x,oy=ui.mouse.y-ui.y}; ui.mouse.clicked=false
    end

    -- ---- search box (top-right) ----
    local sbw, sbh = 210, 22
    local sbx, sby = cx+cw-sbw, sy-2
    local focused = ui.search_focus
    draw.RectFilled(sbx,sby,sbw,sbh, a(focused and theme.field_hi or theme.field,1),6)
    draw.Rect(sbx,sby,sbw,sbh, a(focused and theme.accent or theme.rail, focused and 0.8 or 1),6,1)
    -- magnifier glyph
    draw.Circle(sbx+12,sby+sbh*0.5-1,4, a(theme.sub,1),14,1.3)
    draw.Line(sbx+15,sby+sbh*0.5+2,sbx+18,sby+sbh*0.5+5, a(theme.sub,1),1.3)
    if has_q then
        tmid(sbx+26,sby,sbh, ui.search, a(theme.text,1),12)
        -- blinking caret
        if focused and math.floor(t*2)%2==0 then
            local cwid=tsize(ui.search,12)
            draw.RectFilled(sbx+27+cwid, sby+5, 1, sbh-10, a(theme.accent,1))
        end
        -- clear X
        local xx=sbx+sbw-16
        local xhot=inside(xx-4,sby,20,sbh)
        tmid(xx,sby,sbh,"x", a(xhot and theme.accent or theme.sub,1),12)
        if xhot and ui.mouse.clicked then ui.search=""; ui.mouse.clicked=false end
    else
        tmid(sbx+26,sby,sbh, focused and "" or "Search features...", a(theme.faint,1),12)
        if focused and math.floor(t*2)%2==0 then
            draw.RectFilled(sbx+27, sby+5, 1, sbh-10, a(theme.accent,1))
        end
    end
    -- focus toggle: click inside focuses, click elsewhere in window blurs
    if ui.mouse.clicked then
        if inside(sbx,sby,sbw,sbh) then ui.search_focus=true; ui.mouse.clicked=false
        else ui.search_focus=false end
    end

    draw.Line(cx,sy+20,cx+cw,sy+20, a(theme.line,1),1)

    if has_q then
        draw_search_results(t, ui.search)
        return
    end

    ui.tab_fade=approach("tabfade",1,9)
    if ui.tab_fade<0.999 and ui.prev_tab~=ui.tab then
        draw_columns(tabs[ui.prev_tab], -16*ui.tab_fade, 1-ui.tab_fade, ui.tab_time-1)
    end
    local total=draw_columns(tabs[ui.tab], (1-ui.tab_fade)*18, ui.tab_fade, t)

    local scy = ui.y+theme.pad+26
    local sch = ui.h-theme.pad*2-26
    if total > sch then
        local BAR_W  = 12  -- wide, easy to grab
        local trx    = ui.x + ui.w - BAR_W - 3
        local maxs   = total - sch
        local scroll = ui.scroll[ui.tab] or 0
        local thumb  = math.max(40, sch*(sch/total))
        local thy    = scy + (sch-thumb) * (scroll/maxs)

        -- Track background
        draw.RectFilled(trx-1, scy, BAR_W+2, sch, {0,0,0,0.5}, 6)
        draw.RectFilled(trx, scy, BAR_W, sch, a(theme.rail, 0.35), 6)

        -- Thumb
        local thumb_hot = inside(trx-8, thy, BAR_W+16, thumb) and not ui.popup and not ui.picker
        local hv = approach("scr_hv", thumb_hot and 1 or 0, 16)
        local tc = mix(theme.accent, {1,1,1,1}, hv*0.3)
        draw.RectFilled(trx, thy, BAR_W, thumb, {tc[1],tc[2],tc[3], 0.75+hv*0.25}, 6)
        -- Bright edge highlight on thumb
        draw.Line(trx+2, thy+2, trx+BAR_W-2, thy+2, {1,1,1,0.2+hv*0.3}, 1)

        -- Drag scrollbar
        if thumb_hot and ui.mouse.clicked and not ui.drag then
            ui.drag = {kind="scroll", oy=ui.mouse.y-thy, ty=scy, th=sch, thumb=thumb, max=maxs}
            ui.mouse.clicked = false
        end
        if ui.drag and ui.drag.kind=="scroll" then
            local d = ui.drag
            ui.scroll[ui.tab] = clamp((ui.mouse.y-d.oy-d.ty)/(d.th-d.thumb), 0, 1) * d.max
        end

        -- Click on track (not thumb) = jump to that position
        if not thumb_hot and inside(trx-4, scy, BAR_W+8, sch) and ui.mouse.clicked
           and not ui.popup and not ui.picker then
            local rel = (ui.mouse.y - scy) / sch
            ui.scroll[ui.tab] = clamp(rel * maxs, 0, maxs)
            ui.mouse.clicked = false
        end

        -- Scroll indicator arrows at top/bottom of track
        if scroll > 0 then
            draw.Text(trx + BAR_W*0.5 - 3, scy + 2, "▲", {1,1,1,0.5}, 9)
        end
        if scroll < maxs - 1 then
            draw.Text(trx + BAR_W*0.5 - 3, scy + sch - 12, "▼", {1,1,1,0.5}, 9)
        end

        -- "Drag scrollbar" hint — only shown once, fades
        local hint_a = math.max(0, 1 - (scroll / math.max(1, maxs)) * 2) * 0.45
        if hint_a > 0.05 then
            local htxt = "scroll ▶"
            local hw = draw.GetTextSize(htxt, 9)
            draw.Text(trx - hw - 6, scy + sch - 13, htxt, {1,1,1,hint_a}, 9)
        end
    else
        ui.scroll[ui.tab] = 0
        ui.scroll_pan_start = nil
    end
end

