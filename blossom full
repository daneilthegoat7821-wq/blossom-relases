BHop_WAS_GROUNDED = true

local function run_bunnyhop()
    if not ui.vals["bunnyhop_on"] then return end
    local lp = entity.GetLocalPlayer()
    if not lp then return end
    -- Jump at the exact frame we land
    local vel = lp.Velocity
    local grounded = vel and math.abs(vel.Y or 0) < 1
    if grounded and not BHop_WAS_GROUNDED then
        pcall(function() applygc("Jump", true) end)
    end
    BHop_WAS_GROUNDED = grounded
end

local function run_autostrafe()
    if not ui.vals["autostrafe_on"] then return end
    local look = camera.GetLookVector()
    if not look then return end
    local mx,my = utility.GetMousePos()
    local sw2,_ = draw.GetScreenSize()
    -- If mouse moving right, strafe right; left = strafe left
    -- Simple: apply sideways movement based on camera rotation change
    local lp = entity.GetLocalPlayer()
    if not lp then return end
    pcall(function()
        local vel = lp.Velocity
        if vel then
            local speed = math.sqrt(vel.X*vel.X+vel.Z*vel.Z)
            if speed > 5 then
                -- Apply strafe boost in current movement direction
                local t4 = ib_clock()
                local strafe = math.sin(t4*4)*8
                lp.Velocity = Vector3.New(vel.X+strafe*look.Z, vel.Y, vel.Z-strafe*look.X)
            end
        end
    end)
end

