-- TELEPORT TO PLAYER / EXTRACT
-- =============================================================
TP_PLAYER_COOLDOWN = 0

local function run_teleports()
    local now = utility.GetTime()

    -- TP to player
    if ui.vals["tp_to_player_on"] then
        local tkey = ui.binds["tp_to_player_key"] or 0
        if tkey ~= 0 and input.IsKeyDown(tkey) and now-TP_PLAYER_COOLDOWN > 1 then
            TP_PLAYER_COOLDOWN = now
            local lp = entity.GetLocalPlayer()
            local players = entity.GetPlayers()
            if lp and players then
                local mode = math.floor(fvn("tp_to_player_target") or 1)
                local mpos = lp.Position
                local best_p2 = nil
                local best_val = math.huge

                for _,p in ipairs(players) do
                    if not p.IsLocal and p.IsValid and p.IsAlive then
                        if mode == 1 then  -- Nearest
                            local pos = p.Position
                            if pos and mpos then
                                local d=(pos.X-mpos.X)^2+(pos.Y-mpos.Y)^2+(pos.Z-mpos.Z)^2
                                if d<best_val then best_val=d; best_p2=p end
                            end
                        elseif mode == 2 then  -- Lowest HP
                            local hp=p.Health or 100
                            if hp<best_val then best_val=hp; best_p2=p end
                        elseif mode == 3 then  -- Highest threat
                            local tc2=THREAT_CACHE[p.Name]
                            local sc3=tc2 and tc2.score or 0
                            if sc3>best_val or best_val==math.huge then
                                best_val=-sc3; best_p2=p
                            end
                        end
                    end
                end

                if best_p2 then
                    local tp = best_p2.Position
                    if tp then
                        pcall(function()
                            lp.Position = Vector3.New(tp.X, tp.Y+2, tp.Z)
                            lp.Velocity = Vector3.New(0,0,0)
                        end)
                        notify.Success("TP","Teleported to "..best_p2.Name,2)
                    end
                end
            end
        end
    end

    -- TP to nearest extract
    if ui.vals["tp_to_extract_on"] then
        local ekey = ui.binds["tp_to_extract_key"] or 0
        if ekey ~= 0 and input.IsKeyDown(ekey) and now-TP_PLAYER_COOLDOWN > 1 then
            TP_PLAYER_COOLDOWN = now
            local lp = entity.GetLocalPlayer()
            if lp and #world.extracts > 0 then
                local mpos = lp.Position
                local best_e = nil; local best_d2 = math.huge
                for _,e in ipairs(world.extracts) do
                    if e.part then
                        local pos = e.part.position
                        if pos and mpos then
                            local d=(pos.x-mpos.X)^2+(pos.y-mpos.Y)^2+(pos.z-mpos.Z)^2
                            if d<best_d2 then best_d2=d; best_e=e end
                        end
                    end
                end
                if best_e and best_e.part then
                    local pos = best_e.part.position
                    pcall(function()
                        lp.Position = Vector3.New(pos.x, pos.y+2, pos.z)
                        lp.Velocity = Vector3.New(0,0,0)
                    end)
                    notify.Success("TP","Teleported to "..best_e.name,2)
                end
            end
        end
    end
end

