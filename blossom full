-- DROPDOWN
-- =========================================================
local function popup_input()
    local p=ui.popup; if not p then return end
    local ph=#p.items*24+6
    if ui.mouse.clicked then
        if inside(p.x,p.y,p.w,ph) then
            local idx=math.floor((ui.mouse.y-p.y-3)/24)+1
            if idx>=1 and idx<=#p.items then ui.vals[p.id]=idx; log("Selected '"..p.items[idx].."'.") end
        end
        ui.popup=nil; ui.mouse.clicked=false
    end
end
local function popup_draw()
    local p=ui.popup; if not p then return end
    p.t=approach("popup_t",1,22)
    local ph=#p.items*24+6
    local sc=ease_out(p.t)
