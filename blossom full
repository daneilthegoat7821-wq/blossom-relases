local KILL_UPD_LAST = 0
local function update_kill_counter()
    local _t = utility.GetTime()
    if _t - KILL_UPD_LAST < 0.1 then return end  -- max 10x/sec
    KILL_UPD_LAST = _t
    if not ui.vals["kill_counter_on"] and
       not ui.vals["session_stats_on"] then return end
    if SESSION_START == 0 then SESSION_START = utility.GetTime() end
    -- Clear stale entries for players who left
    if #players < 10 then
        local alive = {}; for _,p in ipairs(players) do alive[p.Name]=true end
        for k in pairs(KILL_PREV_HP) do if k~="_self" and not alive[k] then KILL_PREV_HP[k]=nil end end
    end
    local players = entity.GetPlayers()
    if not players then return end
    for _,p in ipairs(players) do
        if not p.IsLocal and p.IsValid then
            local hp = p.Health or 0
            local prev = KILL_PREV_HP[p.Name]
            if prev then
                if prev > 0 and hp <= 0 then SESSION_KILLS=SESSION_KILLS+1 end
                if prev > hp then SESSION_DMG=SESSION_DMG+(prev-hp) end
            end
            KILL_PREV_HP[p.Name]=hp
        elseif p.IsLocal then
            local hp = p.Health or 100
            local prev = KILL_PREV_HP["_self"]
            if prev and prev > 0 and hp <= 0 then SESSION_DEATHS=SESSION_DEATHS+1 end
            KILL_PREV_HP["_self"]=hp
        end
    end
end

