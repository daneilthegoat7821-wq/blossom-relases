DMG_NUMS = {}  -- {x,y,dmg,t,crit}

local function draw_damage_numbers()
    if not ui.vals["dmg_nums_on"] then DMG_NUMS={}; return end
    local t = ib_clock()
    local life = fvn("dmg_nums_life") or 2
    local fsz  = fvn("dmg_nums_size") or 14
    local dc   = ui.colors["_dmgnum"] or {1,0.9,0.3,1}
    local hc   = ui.colors["_dmghs"]  or {1,0.4,0.4,1}
    local keep = {}
    for _,d in ipairs(DMG_NUMS) do
        local age = t-d.t
        if age < life then
            local fa  = 1-age/life
            local rise= age*30  -- float upward
            local col = d.crit and hc or dc
            local txt = d.crit and ("!! "..d.dmg.." !!") or tostring(d.dmg)
            local tw  = draw.GetTextSize(txt, fsz)
            -- Shadow
            draw.Text(d.x-tw*0.5+1, d.y-rise+1, txt, {0,0,0,fa*0.8}, fsz)
            draw.Text(d.x-tw*0.5,   d.y-rise,   txt, {col[1],col[2],col[3],fa}, fsz)
            keep[#keep+1]=d
        end
    end
    DMG_NUMS = keep
end

-- Hook into hit detection to spawn damage numbers
local DMG_PREV_HP = {}
local DMG_UPD_LAST = 0
local function update_damage_numbers()
    local _t = utility.GetTime()
    if _t - DMG_UPD_LAST < 0.05 then return end  -- max 20x/sec
    DMG_UPD_LAST = _t
    if not ui.vals["dmg_nums_on"] then DMG_PREV_HP={}; return end
    local players = entity.GetPlayers()
    if not players then return end
    for _,p in ipairs(players) do
        if not p.IsLocal and p.IsValid then
            local hp = p.Health or 100
            local prev = DMG_PREV_HP[p.Name]
            if prev and prev > hp then
                local dmg = math.floor(prev-hp)
                if dmg > 0 then
                    local pos = p.HeadPosition or p.Position
                    if pos then
                        local sx,sy,sv = draw.WorldToScreen(pos.X,pos.Y+1,pos.Z)
                        if sv then
                            -- Crit = headshot proxy: took >50 dmg in one hit
                            local crit = dmg >= 50 and ui.vals["dmg_nums_crit"]
                            DMG_NUMS[#DMG_NUMS+1]={x=sx,y=sy,dmg=dmg,t=ib_clock(),crit=crit}
                        end
                    end
                end
            end
            DMG_PREV_HP[p.Name]=hp
        end
    end
end

