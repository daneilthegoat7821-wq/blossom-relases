-- =============================================================
-- AIMBOT ENGINE — all types, verified API only
-- =============================================================
AIM_BONES_MAP = {"Head","Neck","UpperTorso","LowerTorso","Head"}
-- "Closest" handled separately via FOV loop

TRIG_LAST_FIRE = 0  -- last triggerbot fire timestamp

-- Bullet TP state — teleport to target on fire, snap back next frame
BTP_ORIGIN   = nil   -- our real position before snap
BTP_SNAPPED  = false -- true while we're at the target
BTP_FIRE_WAS = false -- edge detect on left click

local function aim_get_target_pos(p, bone_idx, pred_ms)
    -- Get bone screen + world position, apply velocity prediction if enabled
    local bone = AIM_BONES_MAP[math.max(1,math.min(5,bone_idx))] or "Head"
    local wpos

    if bone_idx == 5 then
        -- Closest bone: pick whichever bone is closest to screen center
        local scx,scy = input.GetScreenCenter()
        local best_d  = math.huge
        local best_wp = nil
        for _,bname in ipairs({"Head","UpperTorso","LowerTorso"}) do
            local sx,sy,sv = p:GetBoneScreen(bname)
            if sv then
                local d=math.sqrt((sx-scx)^2+(sy-scy)^2)
                if d<best_d then
                    best_d=d
                    -- Convert back to approx world pos via HeadPosition offset
                    best_wp = p.HeadPosition or p.Position
                end
            end
        end
        wpos = best_wp
    else
        -- Direct bone world position
        wpos = p.HeadPosition
        if bone == "UpperTorso" or bone == "Neck" then
            local hp = p.HeadPosition
            local rp = p.Position
            if hp and rp then
                wpos = {X=(hp.X+rp.X)*0.5, Y=(hp.Y+rp.Y)*0.5, Z=(hp.Z+rp.Z)*0.5}
            end
        elseif bone == "LowerTorso" then
            wpos = p.Position
        end
    end

    if not wpos then return nil end

    -- Velocity prediction
    if pred_ms and pred_ms > 0 then
        local vel = p.Velocity
        if vel then
            local dt = pred_ms / 1000
            return {
                X = wpos.X + vel.X * dt,
                Y = wpos.Y + vel.Y * dt,
                Z = wpos.Z + vel.Z * dt,
            }
        end
    end
    return wpos
end

local function run_silent_aim()
    if not sg("aim_on") then
        pcall(raycast.ClearSilentTarget)
        return
    end

    -- Use screen size center — matches game viewport crosshair exactly
    local sw, sh   = draw.GetScreenSize()
    local scx, scy = sw * 0.5, sh * 0.5
    local aim_key  = ui.binds["aim_key"] or 0x02
    local fov_lim  = fvn("fov_size") or 150
    local bone_idx = math.floor(fvn("aim_bone") or 1)
    local smooth   = math.max(1, math.floor(fvn("aim_smooth") or 8))
    local aim_type = math.floor(fvn("aim_type") or 1)
    local vis_only = ui.vals["bs_aim_vis"]
    local do_pred  = ui.vals["aim_prediction"]
    local pred_ms  = do_pred and (fvn("aim_pred_ms") or 100) or 0
    local key_held = input.IsKeyDown(aim_key)

    -- FOV circle at true game center
    if ui.vals["bs_aim_draw_fov"] then
        local fc = ui.colors["_fov"] or theme.accent
        draw.Circle(scx,scy,fov_lim,{fc[1],fc[2],fc[3],0.18},64,1)
        draw.Circle(scx,scy,fov_lim,{fc[1],fc[2],fc[3],0.05},64,4)
    end

    if not key_held then
        if aim_type == 1 or aim_type == 5 or aim_type == 6 then
            pcall(raycast.StopSilentTracking)
            pcall(raycast.ClearSilentTarget)
        end
        return
    end

    local players = entity.GetPlayers()
    if not players then return end

    -- Pick bone name for GetBoneScreen check
    local bone_screen_names = {"Head","Head","UpperTorso","LowerTorso","Head"}
    local check_bone = bone_screen_names[bone_idx] or "Head"

    local best_fov = fov_lim
    local best_p   = nil
    local best_wp  = nil
    local best_bx, best_by = scx, scy

    for _,p in ipairs(players) do
        if p.IsLocal or not p.IsAlive or not p.IsValid then goto acont end

        if vis_only then
            local vis = false
            pcall(function()
                local char = p.Character
                if char then vis = raycast.IsPlayerVisible(char) end
            end)
            if not vis then goto acont end
        end

        -- GetBoneScreen = correct screen coords, same space as draw calls
        local bx, by, bvis
        if bone_idx == 5 then
            local min_d = math.huge
            for _,bn in ipairs({"Head","UpperTorso","LowerTorso"}) do
                local sx2,sy2,sv2 = p:GetBoneScreen(bn)
                if sv2 then
                    local d = (sx2-scx)*(sx2-scx) + (sy2-scy)*(sy2-scy)
                    if d < min_d then min_d=d; bx=sx2; by=sy2; bvis=true end
                end
            end
        else
            bx, by, bvis = p:GetBoneScreen(check_bone)
        end

        if not bvis then goto acont end

        local fov = math.sqrt((bx-scx)*(bx-scx) + (by-scy)*(by-scy))

        if fov < best_fov then
            best_fov = fov
            best_p   = p
            best_bx  = bx
            best_by  = by
            best_wp  = aim_get_target_pos(p, bone_idx, pred_ms)
        end

        ::acont::
    end

    if not best_p then
        if aim_type == 1 or aim_type == 5 then
            pcall(raycast.ClearSilentTarget)
        end
        return
    end

    -- ── AIM TYPE DISPATCH ──────────────────────────────────
    if aim_type == 1 then
        -- Silent Aim via TrackSilentTarget — engine-level intercept.
        -- Uses Vector3 subtraction exactly as the API example shows.
        if not raycast.IsSilentHookActive() then pcall(raycast.EnableSilentHook) end
        local lp = entity.GetLocalPlayer()
        local target_pos = best_p and (best_p.HeadPosition or best_p.Position)
        local origin = lp and (lp.HeadPosition or lp.Position)
        if origin and target_pos then
            local dir = target_pos - origin  -- Vector3 operator, matches API example
            pcall(raycast.TrackSilentTarget, origin, dir, 0x01)
        else
            pcall(raycast.StopSilentTracking)
        end

    elseif aim_type == 2 then
        -- Camera Lock: smooth = 1 is instant, higher = slower follow
        if best_wp then pcall(camera.LookAt, best_wp.X, best_wp.Y, best_wp.Z, smooth) end

    elseif aim_type == 3 then
        -- Mouse Steer: fractional move toward bone screen pos each frame
        local dx = best_bx - scx
        local dy = best_by - scy
        local spd = math.max(0.5, smooth * 0.5)
        input.MoveMouse(dx / spd, dy / spd)

    elseif aim_type == 4 then
        -- Prediction + Camera
        local wp2 = aim_get_target_pos(best_p, bone_idx, fvn("aim_pred_ms") or 100)
        if wp2 then pcall(camera.LookAt, wp2.X, wp2.Y, wp2.Z, smooth) end

    elseif aim_type == 5 then
        -- Prediction + Silent: lead target position then TrackSilentTarget
        if not raycast.IsSilentHookActive() then pcall(raycast.EnableSilentHook) end
        local lp = entity.GetLocalPlayer()
        local origin = lp and (lp.HeadPosition or lp.Position)
        local target_pos = best_p and (best_p.HeadPosition or best_p.Position)
        if origin and target_pos then
            -- Apply velocity prediction manually then build direction
            local vel = best_p.Velocity
            local dt = (fvn("aim_pred_ms") or 100) / 1000
            local pred_x = target_pos.X + (vel and vel.X or 0) * dt
            local pred_y = target_pos.Y + (vel and vel.Y or 0) * dt
            local pred_z = target_pos.Z + (vel and vel.Z or 0) * dt
            local dir = Vector3.New(pred_x-origin.X, pred_y-origin.Y, pred_z-origin.Z)
            pcall(raycast.TrackSilentTarget, origin, dir, 0x01)
        else
            pcall(raycast.StopSilentTracking)
        end

    elseif aim_type == 6 then
        -- ── BULLET TP + LEG LOCK — TRIPLE BYPASS ───────────────
        -- Three simultaneous methods every firing frame:
        -- 1. Camera instantly snaps to target legs (always, no click)
        -- 2. Body TP to 0.5 studs above their feet on fire
        -- 3. SetSilentTarget called EVERY frame (not just key-held)
        --    from our TP position pointing at their LowerTorso
        --    This bypasses register delay — server sees bullet
        --    originating inside their lower hitbox regardless of lag.
        local lp = entity.GetLocalPlayer()
        if not lp then goto btp_end end

        -- Get leg bone position — LeftFoot is the most reliable lower bone
        local leg_pos = nil
        pcall(function()
            local char = best_p and best_p.Character
            if char then
                local foot = char:FindFirstChild("LeftFoot") or
                             char:FindFirstChild("RightFoot") or
                             char:FindFirstChild("Left Leg") or
                             char:FindFirstChild("Right Leg")
                if foot then
                    local pos = foot.Position or foot.position
                    if pos then
                        leg_pos = {X=pos.X, Y=pos.Y+0.5, Z=pos.Z}
                    end
                end
            end
        end)
        -- Fallback to LowerTorso/Position if feet not found
        if not leg_pos then
            local base = best_p and best_p.Position
            if base then leg_pos = {X=base.X, Y=base.Y+0.5, Z=base.Z} end
        end

        -- STEP 1: LEG LOCK — always on, no click needed
        -- Camera snaps to feet/lower legs every frame
        if leg_pos then
            pcall(camera.LookAt, leg_pos.X, leg_pos.Y, leg_pos.Z, 1)
        end

        -- Ensure silent hook is always active
        if not raycast.IsSilentHookActive() then
            pcall(raycast.EnableSilentHook)
        end

        local fire_down = input.IsKeyDown(0x01)

        -- STEP 4: Snap back from last frame's TP FIRST
        if BTP_SNAPPED then
            if BTP_ORIGIN then
                pcall(function()
                    lp.Position = Vector3.New(BTP_ORIGIN.X, BTP_ORIGIN.Y, BTP_ORIGIN.Z)
                    lp.Velocity = Vector3.New(0, 0, 0)
                end)
            end
            BTP_SNAPPED = false
            BTP_ORIGIN  = nil
        end

        if fire_down and leg_pos then
            local cur = lp.Position
            if cur then
                BTP_ORIGIN = {X=cur.X, Y=cur.Y, Z=cur.Z}

                -- STEP 2: TP to 0.5 studs above their feet
                -- Y offset keeps us at foot level, not clipping floor
                pcall(function()
                    lp.Position = Vector3.New(leg_pos.X, leg_pos.Y, leg_pos.Z)
                    lp.Velocity = Vector3.New(0, 0, 0)
                end)
                BTP_SNAPPED = true

                -- STEP 3: SetSilentTarget from our new position to their legs
                -- Using SetSilentTarget (per-frame) not TrackSilentTarget (key-held)
                -- because SetSilentTarget fires on the EXACT frame we're at target
                -- position — maximum bullet registration accuracy
                local new_origin = lp.HeadPosition or lp.Position
                if new_origin and leg_pos then
                    local dir = Vector3.New(
                        leg_pos.X - new_origin.X,
                        leg_pos.Y - new_origin.Y,
                        leg_pos.Z - new_origin.Z
                    )
                    pcall(raycast.SetSilentTarget, new_origin, dir)
                    -- Also keep TrackSilentTarget as background backup
                    pcall(raycast.TrackSilentTarget, new_origin, dir, 0x01)
                end
            end
        elseif not fire_down then
            -- Not firing — keep leg lock camera, clear ray override
            pcall(raycast.ClearSilentTarget)
            pcall(raycast.StopSilentTracking)
        end

        ::btp_end::
    end

    -- Triggerbot
    if ui.vals["trig_on"] then
        local trig_key = ui.binds["trig_key"] or 0x05
        if input.IsKeyDown(trig_key) and best_fov < 20 then
            local now = utility.GetTime()
            local delay = (fvn("trig_delay") or 50) / 1000
            if now - TRIG_LAST_FIRE >= delay then
                TRIG_LAST_FIRE = now
                pcall(function() applygc("Firing", true) end)
            end
        end
    end
end

