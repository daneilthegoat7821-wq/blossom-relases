-- CUSTOM COLOR PICKER  (HSV + alpha)  — the "make your own color" tool
-- =========================================================
local PICK_W, PICK_H = 236, 210
local function picker_draw_and_input()
    local pk=ui.picker; if not pk then return end
    pk.t=approach("pick_t",1,20)
    local sc=ease_out(pk.t)
    local x,y = pk.x, pk.y
    local w,h = PICK_W, PICK_H

    -- close if clicking fully outside
    if ui.mouse.clicked and not inside(x,y,w,h) then ui.picker=nil; ui.mouse.clicked=false; return end

    soft(x,y,w,h,_BLK_FULL,9,6,0.6)
    draw.RectFilled(x,y,w,h, a({0.05,0.052,0.06,1},1),9)
    draw.Rect(x,y,w,h, a(theme.accent,0.5),9,1)

    local pad=12
    local svx,svy = x+pad, y+pad+16
    local svw,svh = w-pad*2-26, 108
    -- header
    tmid(x+pad,y,pad+16,"Custom · "..(pk.label or "Color"), a(theme.text,1),12)
    tright(x+w-pad,y,pad+16,"esc/out to close", a(theme.faint,1),9)

    -- SV box: base hue, white->right gradient, black->bottom overlay
    local hue_col = hsv(pk.h,1,1)
    grad_h(svx,svy,svw,svh,{1,1,1,1},hue_col,20)             -- white -> hue
    -- vertical black overlay via horizontal slices of increasing alpha
    local vsteps=20
    for i=0,vsteps-1 do
        local ah=svh/vsteps
        draw.RectFilled(svx, svy+i*ah, svw, ah+1, {0,0,0, (i/(vsteps-1))}, 0)
    end
    draw.Rect(svx,svy,svw,svh, a(theme.line,1),0,1)
    -- SV cursor
    local cxp = svx + pk.s*svw
    local cyp = svy + (1-pk.v)*svh
    draw.Circle(cxp,cyp,5,{1,1,1,1},20,1.5)
    draw.Circle(cxp,cyp,5.5,{0,0,0,1},20,1)
    if inside(svx,svy,svw,svh) and ui.mouse.clicked then ui.picker.drag="sv" end
    if pk.drag=="sv" then
        pk.s=clamp((ui.mouse.x-svx)/svw,0,1)
        pk.v=clamp(1-(ui.mouse.y-svy)/svh,0,1)
    end

    -- Hue strip (vertical)
    local hx,hy = svx+svw+8, svy
    local hw,hh = 18, svh
    local hsteps=24
    for i=0,hsteps-1 do
        local seg=hh/hsteps
        draw.RectFilled(hx, hy+i*seg, hw, seg+1, hsv(i/hsteps,1,1), 0)
    end
    draw.Rect(hx,hy,hw,hh, a(theme.line,1),0,1)
    local hcy=hy+pk.h*hh
    draw.Rect(hx-2,hcy-2,hw+4,4,{1,1,1,1},1,1.5)
    if inside(hx,hy,hw,hh) and ui.mouse.clicked then ui.picker.drag="hue" end
    if pk.drag=="hue" then pk.h=clamp((ui.mouse.y-hy)/hh,0,1) end

    -- Alpha strip (horizontal)
    local ax,ay = svx, svy+svh+10
    local aw,ah = svw+8+hw, 14
    -- checker
    local cells=math.floor(aw/8)
    for i=0,cells do
        local on = (i%2==0)
        draw.RectFilled(ax+i*8, ay, 8, ah, on and {0.28,0.28,0.30,1} or {0.16,0.16,0.18,1},0)
    end
    grad_h(ax,ay,aw,ah, {hue_col[1],hue_col[2],hue_col[3],0}, {hue_col[1],hue_col[2],hue_col[3],1}, 24)
    draw.Rect(ax,ay,aw,ah, a(theme.line,1),0,1)
    local acx=ax+pk.alpha*aw
    draw.Rect(acx-2,ay-2,4,ah+4,{1,1,1,1},1,1.5)
    if inside(ax,ay,aw,ah) and ui.mouse.clicked then ui.picker.drag="alpha" end
    if pk.drag=="alpha" then pk.alpha=clamp((ui.mouse.x-ax)/aw,0,1) end

    -- live preview + hex
    local final = hsv(pk.h,pk.s,pk.v); final[4]=pk.alpha
    local px2,py2 = ax, ay+ah+8
    draw.RectFilled(px2,py2,28,20, final,4)
    draw.Rect(px2,py2,28,20, a(theme.line,1),4,1)
    local R=math.floor(final[1]*255+0.5)
    local G=math.floor(final[2]*255+0.5)
    local B=math.floor(final[3]*255+0.5)
    local Aa=math.floor(final[4]*255+0.5)
    tmid(px2+36,py2,20, string.format("#%02X%02X%02X  a%d%%",R,G,B, math.floor(pk.alpha*100+0.5)), a(theme.text,1),12)

    -- apply live to the bound field every frame
    set_field_color(pk.field, {final[1],final[2],final[3],final[4]})

    -- release drag when mouse up
    if not ui.mouse.down then pk.drag=nil end
end

