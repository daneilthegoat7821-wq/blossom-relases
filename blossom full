-- World item highlight cache: key=tostring(model), val=Highlight instance
WORLD_HL_CACHE = {}

local function world_get_hl(part)
    -- Highlight must be parented to the Model, not the BasePart
    local model = part.Parent or part
    local key = tostring(model)
    local hl = WORLD_HL_CACHE[key]
    -- Validate existing highlight still alive
    if hl then
        local ok = pcall(function() return hl.Parent end)
        if not ok then hl = nil; WORLD_HL_CACHE[key] = nil end
    end
    if not hl then
        pcall(function()
            -- Check it doesn't already have one
            local existing = model:FindFirstChildOfClass("Highlight")
            if existing then hl = existing
            else hl = instance.New("Highlight", model) end
            WORLD_HL_CACHE[key] = hl
        end)
    end
end

local function world_remove_hl(part)
    local model = part.Parent or part
    local key = tostring(model)
    local hl = WORLD_HL_CACHE[key]
    if hl then
        pcall(function() instance.Destroy(hl) end)
        WORLD_HL_CACHE[key] = nil
    end
end

-- Track which parts were highlighted last frame to clean up removed items
WORLD_HL_ACTIVE = {}

local function wdraw(items, rng, col_key, show_names, show_hl)
    local me = entity.GetLocalPlayer()
    local mpos = me and me.Position
    local cx = mpos and mpos.X or 0
    local cy = mpos and mpos.Y or 0
    local cz = mpos and mpos.Z or 0

    -- Get color from ui.colors using the field key
    local c = ui.colors[col_key] or {1,1,1,1}

    for _, d in ipairs(items) do
        if d.part then
            local pos = d.part.position
            if pos then
                local dist = get_dist(pos.x, pos.y, pos.z, cx, cy, cz)
                if dist <= rng / 0.28 then
                    local key = tostring(d.part)
                    WORLD_HL_ACTIVE[key] = true

                    -- Highlight
                    if show_hl then
                        world_get_hl(d.part)
                    else
                        world_remove_hl(d.part)
                    end

                    -- Name + distance label
                    if show_names then
                        local sx, sy, vis = draw.WorldToScreen(pos.x, pos.y, pos.z)
                        if vis then
                            local dist_m = math.floor(dist * 0.28)
                            local txt = string.format("%s  %dm", d.name, dist_m)
                            local tw = draw.GetTextSize(txt, 11)
                            -- Dark background for readability
                            draw.RectFilled(sx - tw*0.5 - 3, sy - 7, tw + 6, 14,
                                {0, 0, 0, 0.55}, 3)
                            draw.Text(sx - tw*0.5, sy - 5, txt,
                                {c[1], c[2], c[3], 0.95}, 11)
                        end
                    end
                else
                    -- Out of range — remove highlight
                    world_remove_hl(d.part)
                end
            end
        end
    end
end

