-- draw a string with manual letter spacing; returns total width
local function tspaced(x, y, str, col, sz, gap)
    sz = sz or 12; gap = gap or 2
    local cx = x
    for i=1,#str do
        local ch = str:sub(i,i)
        draw.Text(cx, y, ch, col, sz)
        local cw = tsize(ch, sz)
        cx = cx + cw + gap
    end
    return cx - x - gap
end
local function tspaced_w(str, sz, gap)
    sz = sz or 12; gap = gap or 2
    local wsum = 0
    for i=1,#str do wsum = wsum + tsize(str:sub(i,i), sz) + gap end
    return wsum - gap
end

-- vector icons: each fn draws a glyph centered in a box (cx,cy) at scale s.
-- col = line color. Uses only line/rect/circle so it recolors with accent.
local icons = {}
function icons.Combat(cx, cy, s, col)   -- crosshair
    local r = s*0.5
    draw.Circle(cx, cy, r, col, 24, 1.4)
    draw.Line(cx-r-2, cy, cx-r*0.4, cy, col, 1.4)
    draw.Line(cx+r*0.4, cy, cx+r+2, cy, col, 1.4)
    draw.Line(cx, cy-r-2, cx, cy-r*0.4, col, 1.4)
    draw.Line(cx, cy+r*0.4, cx, cy+r+2, col, 1.4)
    draw.CircleFilled(cx, cy, 1.4, col, 10)
end
function icons.Visual(cx, cy, s, col)   -- eye
    local w = s*0.62
    draw.Line(cx-w, cy, cx, cy-s*0.36, col, 1.4)
    draw.Line(cx, cy-s*0.36, cx+w, cy, col, 1.4)
    draw.Line(cx+w, cy, cx, cy+s*0.36, col, 1.4)
    draw.Line(cx, cy+s*0.36, cx-w, cy, col, 1.4)
    draw.Circle(cx, cy, s*0.20, col, 18, 1.4)
    draw.CircleFilled(cx, cy, s*0.09, col, 12)
end
function icons.ESP(cx, cy, s, col)   -- target brackets
    local h = s*0.38
    local w = s*0.28
    local t2 = 1.4
    -- top-left
    draw.Line(cx-h, cy-h, cx-h+w, cy-h, col, t2)
    draw.Line(cx-h, cy-h, cx-h, cy-h+w, col, t2)
    -- top-right
    draw.Line(cx+h, cy-h, cx+h-w, cy-h, col, t2)
    draw.Line(cx+h, cy-h, cx+h, cy-h+w, col, t2)
    -- bottom-left
    draw.Line(cx-h, cy+h, cx-h+w, cy+h, col, t2)
    draw.Line(cx-h, cy+h, cx-h, cy+h-w, col, t2)
    -- bottom-right
    draw.Line(cx+h, cy+h, cx+h-w, cy+h, col, t2)
    draw.Line(cx+h, cy+h, cx+h, cy+h-w, col, t2)
    draw.CircleFilled(cx, cy, s*0.07, col, 8)
end
function icons.Movement(cx, cy, s, col) -- chevrons / speed
    local r=s*0.34
    for i=-1,1 do
        local ox = i*r*0.9
        draw.Line(cx+ox-r*0.5, cy-r, cx+ox+r*0.5, cy, col, 1.4)
        draw.Line(cx+ox+r*0.5, cy, cx+ox-r*0.5, cy+r, col, 1.4)
    end
end
function icons.Player(cx, cy, s, col)   -- person
    draw.Circle(cx, cy-s*0.22, s*0.18, col, 18, 1.4)
    -- shoulders arc approximated by two lines + base
    draw.Line(cx-s*0.34, cy+s*0.34, cx-s*0.24, cy+s*0.02, col, 1.4)
    draw.Line(cx+s*0.34, cy+s*0.34, cx+s*0.24, cy+s*0.02, col, 1.4)
    draw.Line(cx-s*0.24, cy+s*0.02, cx+s*0.24, cy+s*0.02, col, 1.4)
    draw.Line(cx-s*0.34, cy+s*0.34, cx+s*0.34, cy+s*0.34, col, 1.4)
end
function icons.HUD(cx, cy, s, col)      -- monitor
    local w,h = s*0.72, s*0.5
    draw.Rect(cx-w*0.5, cy-h*0.5-2, w, h, col, 2, 1.4)
    draw.Line(cx, cy+h*0.5-2, cx, cy+h*0.5+3, col, 1.4)
    draw.Line(cx-s*0.2, cy+h*0.5+3, cx+s*0.2, cy+h*0.5+3, col, 1.4)
end
function icons.Config(cx, cy, s, col)   -- folder
    local w,h = s*0.7, s*0.5
    draw.Line(cx-w*0.5, cy-h*0.5, cx-w*0.1, cy-h*0.5, col, 1.4)
    draw.Line(cx-w*0.1, cy-h*0.5, cx+w*0.02, cy-h*0.5+3, col, 1.4)
    draw.Rect(cx-w*0.5, cy-h*0.5+3, w, h-3, col, 1.5, 1.4)
end
function icons.Settings(cx, cy, s, col) -- gear (octagon ring + hub)
    local r=s*0.34
    local pts=10
    for i=0,pts-1 do
        local a1=(i/pts)*math.pi*2
        local a2=((i+0.5)/pts)*math.pi*2
        local r1 = r
        local r2 = r*0.7
        draw.Line(cx+math.cos(a1)*r1, cy+math.sin(a1)*r1,
                  cx+math.cos(a2)*r2, cy+math.sin(a2)*r2, col, 1.2)
        local a3=((i+1)/pts)*math.pi*2
        draw.Line(cx+math.cos(a2)*r2, cy+math.sin(a2)*r2,
                  cx+math.cos(a3)*r1, cy+math.sin(a3)*r1, col, 1.2)
    end
    draw.Circle(cx, cy, r*0.4, col, 16, 1.3)
end
-- map tab name -> icon fn (fallback to a dot)
local function draw_tab_icon(name, cx, cy, s, col)
    local fn = icons[name]
    if fn then fn(cx, cy, s, col)
    else draw.CircleFilled(cx, cy, s*0.2, col, 14) end
end

