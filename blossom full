        draw.Line(x1,y1,x2,y2,dc,th) draw.Line(x3,y3,x4,y4,fvb("xhair_animate") and col2 or dc,th)
    end
    if fvb("xhair_dot") then draw.CircleFilled(scx,scy,th,dcol,8) end
end

