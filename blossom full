ESP_KILL_ICONS = {}
-- Rainbow HSV hue state
ESP_RAINBOW_HUE = 0

-- Helper: HSV to RGB
local function hsv2rgb(h,s,v)
    local i=math.floor(h*6) local f=h*6-i
    local p=v*(1-s) local q=v*(1-f*s) local t2=v*(1-(1-f)*s)
    local r,g,b
    i=i%6
    if i==0 then r,g,b=v,t2,p elseif i==1 then r,g,b=q,v,p
    elseif i==2 then r,g,b=p,v,t2 elseif i==3 then r,g,b=p,q,v
    elseif i==4 then r,g,b=t2,p,v else r,g,b=v,p,q end
    return r,g,b
end

-- Helper: get base ESP color, applying rainbow if enabled
local function esp_col(base, alpha)
    alpha = alpha or 1
    if ui.vals["esp_rainbow"] then
        local r,g,b = hsv2rgb(ESP_RAINBOW_HUE,0.9,1)
        return {r,g,b,alpha}
    end
    return {(base[1] or 1),(base[2] or 1),(base[3] or 1),alpha}
end

-- Helper: compute per-player alpha with fade-by-distance
local function esp_player_alpha(dist_studs, max_studs, base_alpha)
    local a = base_alpha
    if ui.vals["esp_fade_dist"] then
        local fade = 1 - math.max(0, math.min(1, dist_studs / max_studs))
        a = a * fade
    end
    return math.max(0, math.min(1, a))
end

-- Helper: draw 3D corner box from 8 screen points
local function draw_3d_corner_box(pts, col, thick)
    -- pts = table of 8 {sx,sy} (bottom 4 first, top 4 next)
    -- bottom: 1-2-3-4, top: 5-6-7-8, verticals: 1-5,2-6,3-7,4-8
    local function line(a,b) draw.Line(a[1],a[2],b[1],b[2],col,thick) end
    local function corner_seg(a,b,frac)
        local dx,dy=b[1]-a[1],b[2]-a[2]
        draw.Line(a[1],a[2],a[1]+dx*frac,a[2]+dy*frac,col,thick)
        draw.Line(b[1],b[2],b[1]-dx*frac,b[2]-dy*frac,col,thick)
    end
    local f=0.3
    local edges={{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
    for _,e in ipairs(edges) do corner_seg(pts[e[1]],pts[e[2]],f) end
end

-- Helper: project 8 world-space corners of a character AABB to screen
local function get_3d_box_pts(p)
    local pos = p.Position
    if not pos then return nil end
    local b = p:GetBounds()
    if not b or not b.valid then return nil end
    -- Estimate world half-extents from screen bounds
    -- Use head and HRP bone to get world-space top/bottom Y
    local hx,hy,hv = p:GetBoneScreen("Head")
    local rx,ry,rv = p:GetBoneScreen("HumanoidRootPart")
    if not hv or not rv then
        hx,hy,hv = p:GetBoneScreen("UpperTorso")
    end
    -- Fall back to screen bounds box corners projected as flat box
    -- (true 3D needs world-space; use screen-space approximation with depth)
    local hw = b.w * 0.5
    local pts = {
        {b.x,       b.y+b.h}, {b.x+b.w,   b.y+b.h},
        {b.x+b.w,   b.y},     {b.x,       b.y},
        {b.x+hw*0.3,     b.y+b.h-4}, {b.x+b.w-hw*0.3, b.y+b.h-4},
        {b.x+b.w-hw*0.3, b.y+4},     {b.x+hw*0.3,     b.y+4},
    }
    return pts
end

-- Multi-color chams renderer
local function run_esp_chams(p, t, is_vis)
    if not ui.vals["cham_on"] then return end
    local mode = math.floor(fvn("cham_mode") or 3)
    local draw_vis = (mode==1 or mode==3) and is_vis
    local draw_hid = (mode==2 or mode==3) and not is_vis
    if not draw_vis and not draw_hid then return end

    local render = math.floor(fvn("cham_render") or 1) - 1
local cham_anim = math.floor(fvn("cham_anim_mode") or 1)
    local spd    = (fvn("cham_anim_speed") or 5)
    local vis_a  = (fvn("cham_vis_alpha") or 60) / 100
    local hid_a  = (fvn("cham_hid_alpha") or 35) / 100
    local base_a = draw_vis and vis_a or hid_a

    -- Build active color slots
    local slots = {}
    local cc = {
        {id="cham_c1_on",col="_cc1",cov="cham_c1_cov"},
        {id="cham_c2_on",col="_cc2",cov="cham_c2_cov"},
        {id="cham_c3_on",col="_cc3",cov="cham_c3_cov"},
        {id="cham_c4_on",col="_cc4",cov="cham_c4_cov"},
        {id="cham_c5_on",col="_cc5",cov="cham_c5_cov"},
    }
    for _,s in ipairs(cc) do
        if ui.vals[s.id] then
            local c = ui.colors[s.col] or {1,1,1,1}
            local cov = (fvn(s.cov) or 100) / 100
            slots[#slots+1] = {r=c[1],g=c[2],b=c[3],a=base_a,cov=cov}
        end
    end
    if #slots == 0 then
        -- Fallback to single accent color
        local ac = theme.accent
        draw.ChamsPlayer(p, {ac[1],ac[2],ac[3],base_a}, render)
        return
    end

    if cham_anim == 1 or #slots == 1 then
        -- ── STATIC ───────────────────────────────────────────
        local s = slots[1]
        if #slots > 1 then
            local s2 = slots[2]
            draw.ChamsPlayer(p, {s.r,s.g,s.b,s.a}, {s2.r,s2.g,s2.b,s2.a}, render)
        else
            draw.ChamsPlayer(p, {s.r,s.g,s.b,s.a}, render)
        end

    elseif cham_anim == 2 then
        -- ── VORTEX / BLACK HOLE ──────────────────────────────
        -- Colors converge and blend based on a rotating phase offset.
        -- Each color occupies a segment of the 360° wheel.
        -- The wheel spins, pulling colors into the center.
        local phase = t * spd * 0.5
        local seg   = (math.pi * 2) / #slots
        local pi    = math.floor(phase / seg) % #slots + 1
        local si    = pi % #slots + 1
        local blend = (phase % seg) / seg
        -- Inward pull: blend accelerates near center using easeIn
        local pull  = blend * blend
        local s1,s2 = slots[pi], slots[si]
        local r = s1.r*(1-pull)+s2.r*pull
        local g = s1.g*(1-pull)+s2.g*pull
        local b2= s1.b*(1-pull)+s2.b*pull
        local pi2 = (pi + math.max(1,math.floor(#slots/2))) % #slots + 1
        local sec = slots[pi2]
        draw.ChamsPlayer(p, {r,g,b2,base_a}, {sec.r,sec.g,sec.b,base_a*0.7}, render)

    elseif cham_anim == 3 then
        -- ── SPIN ─────────────────────────────────────────────
        -- Color bands rotate continuously. Primary cycles through
        -- all slots; secondary is always 1 slot ahead.
        local dir   = ui.vals["cham_spin_dir"] and 1 or -1
        local phase = (t * spd * dir * 0.6) % #slots
        local pi    = math.floor(phase) % #slots + 1
        local si    = pi % #slots + 1
        local blend = phase - math.floor(phase)
        local s1,s2 = slots[pi], slots[si]
        draw.ChamsPlayer(p,
            {s1.r*(1-blend)+s2.r*blend, s1.g*(1-blend)+s2.g*blend, s1.b*(1-blend)+s2.b*blend, base_a},
            {s2.r,s2.g,s2.b,base_a},
            render)

    elseif cham_anim == 4 then
        -- ── PULSE WAVE ───────────────────────────────────────
        -- Colors ripple outward from body center in concentric waves.
        -- Primary pulses in/out; secondary holds as counter-pulse.
        local wave  = 0.5 + math.sin(t * spd) * 0.5
        local wave2 = 0.5 + math.sin(t * spd + math.pi) * 0.5
        local s1    = slots[1]
        local s2    = slots[math.min(2,#slots)]
        draw.ChamsPlayer(p,
            {s1.r,s1.g,s1.b, base_a*(0.35+wave*0.65)},
            {s2.r,s2.g,s2.b, base_a*(0.35+wave2*0.65)},
            render)

    elseif cham_anim == 5 then
        -- ── LIGHTNING ────────────────────────────────────────
        -- Rapid random-ish flicker between slots using high-frequency
        -- sine combinations — looks like electrical discharge.
        local flick = math.abs(math.sin(t*spd*3.7) * math.cos(t*spd*2.3))
        local surge = math.abs(math.sin(t*spd*7.1)) > 0.7 and 1 or 0
        local pi    = (math.floor(flick * #slots + surge)) % #slots + 1
        local si    = pi % #slots + 1
        local s1,s2 = slots[pi], slots[si]
        local a1    = base_a * (0.5 + flick * 0.5)
        local a2    = base_a * (0.2 + surge * 0.8)
        draw.ChamsPlayer(p, {s1.r,s1.g,s1.b,a1}, {s2.r,s2.g,s2.b,a2}, render)

    elseif cham_anim == 6 then
        -- ── PLASMA SHIFT ─────────────────────────────────────
        -- Smooth multi-frequency oscillation across all slots simultaneously.
        -- Each slot contributes based on its own sine phase offset.
        -- Produces a fluid, plasma-like color morphing effect.
        local r,g,b3,total = 0,0,0,0
        for i,s in ipairs(slots) do
            local phase_i = t * spd * 0.8 + (i-1) * (math.pi*2 / #slots)
            local weight  = math.max(0, math.sin(phase_i))
            r = r + s.r * weight
            g = g + s.g * weight
            b3= b3+ s.b * weight
            total = total + weight
        end
        if total > 0.01 then r=r/total; g=g/total; b3=b3/total end
        -- Secondary: same but phase-shifted by pi
        local r2,g2,b4,t2 = 0,0,0,0
        for i,s in ipairs(slots) do
            local phase_i = t * spd * 0.8 + (i-1)*(math.pi*2/#slots) + math.pi
            local weight  = math.max(0, math.sin(phase_i))
            r2=r2+s.r*weight; g2=g2+s.g*weight; b4=b4+s.b*weight; t2=t2+weight
        end
        if t2>0.01 then r2=r2/t2; g2=g2/t2; b4=b4/t2 end
        draw.ChamsPlayer(p, {r,g,b3,base_a}, {r2,g2,b4,base_a*0.8}, render)

    elseif cham_anim == 7 then
        -- ── CHROMATIC RIPPLE ─────────────────────────────────
        -- Colors chase each other in rapid succession like a rainbow
        -- ripple — each slot leads the next by a fixed phase gap.
        -- Fast spd = tight ripple, slow = wide spread.
        local cycle  = (t * spd * 0.4) % #slots
        local pi     = math.floor(cycle) % #slots + 1
        local si     = pi % #slots + 1
        local ti3    = si % #slots + 1
        local blend  = cycle - math.floor(cycle)
        -- Smooth cubic blend for buttery transitions
        local sm     = blend*blend*(3-2*blend)
        local s1,s2,s3 = slots[pi], slots[si], slots[ti3]
        local r  = s1.r*(1-sm)+s2.r*sm
        local g  = s1.g*(1-sm)+s2.g*sm
        local b2 = s1.b*(1-sm)+s2.b*sm
        draw.ChamsPlayer(p,
            {r,g,b2,base_a},
            {s3.r,s3.g,s3.b,base_a*0.85},
            render)

    elseif cham_anim == 8 then
        -- ── NORTHERN LIGHTS ──────────────────────────────────
        -- Slow, majestic drift between colors using layered low-frequency
        -- sines — mimics the aurora borealis shimmer.
        local drift1 = 0.5 + math.sin(t * spd * 0.15) * 0.5
        local drift2 = 0.5 + math.sin(t * spd * 0.23 + 1.2) * 0.5
        local drift3 = 0.5 + math.sin(t * spd * 0.31 + 2.7) * 0.5
        local n = #slots
        local i1 = math.floor(drift1 * (n-1)) + 1
        local i2 = math.floor(drift2 * (n-1)) + 1
        local i3 = math.floor(drift3 * (n-1)) + 1
        i1=math.min(i1,n); i2=math.min(i2,n); i3=math.min(i3,n)
        local s1,s2,s3 = slots[i1], slots[i2], slots[i3]
        local w1 = drift1; local w2 = drift2; local w3 = drift3
        local wt = w1+w2+w3+0.001
        local r  = (s1.r*w1+s2.r*w2+s3.r*w3)/wt
        local g  = (s1.g*w1+s2.g*w2+s3.g*w3)/wt
        local b2 = (s1.b*w1+s2.b*w2+s3.b*w3)/wt
        -- Gentle alpha shimmer
        local shimmer = 0.85 + math.sin(t*spd*0.4)*0.15
        draw.ChamsPlayer(p,
            {r,g,b2,base_a*shimmer},
            {s3.r*0.6+0.4,s3.g*0.6,s3.b*0.8,base_a*0.5},
            render)

    elseif cham_anim == 9 then
        -- ── LAVA FLOW ────────────────────────────────────────
        -- Colors bubble and surge like molten lava — slow boiling
        -- base with rapid hot-spot flares on top.
        local base_flow = (t * spd * 0.18) % #slots
        local hot_spot  = math.abs(math.sin(t * spd * 1.4)) *
                          math.abs(math.cos(t * spd * 0.9))
        local bi = math.floor(base_flow) % #slots + 1
        local bn = bi % #slots + 1
        local bf = base_flow - math.floor(base_flow)
        local sb,sn = slots[bi], slots[bn]
        -- Base lava color
        local lr = sb.r*(1-bf)+sn.r*bf
        local lg = sb.g*(1-bf)+sn.g*bf
        local lb = sb.b*(1-bf)+sn.b*bf
        -- Hot spot flare: brightest slot flares in
        local hs = slots[math.min(1,#slots)]
        local flare = hot_spot * 0.7
        lr = lr*(1-flare)+hs.r*flare
        lg = lg*(1-flare)+hs.g*flare
        lb = lb*(1-flare)+hs.b*flare
        local surge_a = base_a * (0.7 + hot_spot * 0.3)
        draw.ChamsPlayer(p,
            {lr,lg,lb,surge_a},
            {hs.r,hs.g*0.3,hs.b*0.2,base_a*(0.3+hot_spot*0.7)},
            render)
    end
end

DIST_CACHE = {}  -- dist_m->string cache
DIST_CACHE_T = 0  -- last clear time

local function draw_players_esp()
    if not fvb("esp_on") then return end
    -- Purge dist string cache every 30s to prevent unbounded growth
    local _now2 = utility.GetTime()
    if _now2 - DIST_CACHE_T > 30 then DIST_CACHE={}; DIST_CACHE_T=_now2 end
    local players = entity.GetPlayers()
    if not players then return end

    local me    = entity.GetLocalPlayer()
    local mpos  = me and me.Position
    if not mpos then return end

    local t       = ib_clock()
    local sw, sh  = draw.GetScreenSize()
    local scx,scy = input.GetScreenCenter()

    if ui.vals["esp_rainbow"] then
        ESP_RAINBOW_HUE = (ESP_RAINBOW_HUE + utility.GetDeltaTime() * 0.3) % 1
    end

    local ecol_base = ui.colors["_esp"] or theme.accent
    local bcol_base = ui.colors["_bone"]
    local jcol_base = ui.colors["_joint"]
    local max_dist  = (fvn("esp_render_dist") or 500) / 0.28
    local g_alpha   = (fvn("esp_global_alpha") or 100) / 100
    local scale_base= (fvn("esp_scale") or 100) / 100
    local thick     = fvn("esp_outline_thick") or 1
    local pulse_spd = fvn("esp_pulse_speed") or 6
    local vis_only  = ui.vals["esp_visible_only"]
    local whisper   = ui.vals["esp_whisper"]
    local prio_low_hp = ui.vals["esp_priority_low_hp"]

    -- Reusable per-player color table — set in-place each player, zero alloc
    local ecol_v = {1,1,1,1}

    -- Cache ALL toggle/value reads once per frame — not per player
    local do_box       = ui.vals["esp_box"]
    local box_style    = math.floor(fvn("esp_box_style") or 2)
    local do_lhp       = ui.vals["esp_low_hp_pulse"]
    local do_3dbox     = ui.vals["esp_3d_box"]
    local do_hbar      = ui.vals["esp_health_bar"]
    local do_hdot      = ui.vals["esp_head_dot"]
    local hdot_fill    = ui.vals["esp_head_dot_fill"]
    local hdot_r       = (fvn("esp_head_dot_r") or 5) * scale_base
    local do_name      = ui.vals["esp_name"]
    local name_sz      = fvn("esp_name_size") or 13
    local do_dist      = ui.vals["esp_dist_tag"]
    local do_weapon    = ui.vals["esp_weapon_tag"]
    local do_snap      = ui.vals["esp_snap"]
    local snap_origin  = math.floor(fvn("esp_snap_origin") or 2)
    local snap_thick   = fvn("esp_snap_thick") or 1
    local do_bones     = ui.vals["esp_bones"]
    local bone_thick   = fvn("esp_bone_thick") or 1
    local do_joints    = ui.vals["esp_joints"]
    local joint_fill   = ui.vals["esp_joints_fill"]
    local joint_r      = fvn("esp_joint_radius") or 3
    local do_threat    = ui.vals["esp_threat"]
    local do_crouch    = ui.vals["esp_crouch_icon"]
    local do_sprint    = ui.vals["esp_sprint_icon"]
    local do_camdot    = ui.vals["esp_camera_dot"]
    local do_vel       = ui.vals["esp_velocity_arrow"]
    local do_pred      = ui.vals["esp_aim_pred"]
    local do_footprint = ui.vals["esp_footprints"]
    local footprint_n  = math.floor(fvn("esp_footprint_n") or 8)
    local do_lkp       = ui.vals["esp_last_pos"]
    local do_offscreen = ui.vals["esp_offscreen"]
    local offscreen_r  = fvn("esp_offscreen_r") or 40
    local do_squad     = ui.vals["esp_squad_lines"]
    local do_prio      = ui.vals["esp_priority_low_hp"]
    local do_kill_icon = ui.vals["esp_kill_icon"]

    -- Soft glow: layers semi-transparent wider versions behind elements
    local function glow_rect(x,y,w,h,c,r)
        esp_glow_rect(x,y,w,h,c[1],c[2],c[3],c[4],r)
    end
    local function glow_line(x1,y1,x2,y2,c,w2)
        esp_glow_line(x1,y1,x2,y2,c[1],c[2],c[3],c[4],w2)
    end
    -- Shadow+color text
    local function otext(x,y,txt,c,sz)
        esp_otext(x,y,txt,c[1],c[2],c[3],c[4],sz)
    end

    local prio_name = nil
    if prio_low_hp then
        local lowest = math.huge
        for _,p in ipairs(players) do
            if not p.IsLocal and p.IsValid and p.IsAlive then
                local hp = p.Health or 100
                if hp < lowest then lowest=hp; prio_name=p.Name end
            end
        end
    end

    local squad_pts = {}

    for _,p in ipairs(players) do
        if p.IsLocal then goto epcont end
        if not p.IsValid or not p.IsAlive then
            if ESP_LAST_POS[p.Name] then
                local lp2=ESP_LAST_POS[p.Name]
                local age=t-lp2.t
                if age<5 then
                    local fa=(1-age/5)*g_alpha*0.5
                    local gc={0.7,0.7,0.7,fa}
                    glow_rect(lp2.x,lp2.y,lp2.w,lp2.h,gc,2)
                    draw.Rect(lp2.x,lp2.y,lp2.w,lp2.h,gc,0,1)
                    otext(lp2.x+lp2.w*0.5-draw.GetTextSize("LKP",10)*0.5,lp2.y-12,"LKP",gc,10)
                else ESP_LAST_POS[p.Name]=nil end
            end
            goto epcont
        end

        local pos=p.Position
        if not pos then goto epcont end
        local dx=pos.X-mpos.X local dy=pos.Y-mpos.Y local dz=pos.Z-mpos.Z
        local dist_studs=math.sqrt(dx*dx+dy*dy+dz*dz)
        if dist_studs>max_dist then goto epcont end

        local scale_mult=scale_base

        local is_vis=false
        pcall(function()
            local char=p.Character
            if char then is_vis=raycast.IsPlayerVisible(char) end
        end)
        if vis_only and not is_vis then goto epcont end

        run_esp_chams(p,t,is_vis)

        local b=p:GetBounds()
        local b_valid=b and b.valid

        if whisper then
            if b_valid then
                draw.CircleFilled(b.x+b.w*0.5,b.y+b.h*0.5,4,esp_col(ecol_base,g_alpha))
            end
            goto epcont
        end

        local pa=esp_player_alpha(dist_studs,max_dist,g_alpha)
        local dist_m=math.floor(dist_studs*0.28)

        -- Update ecol_v in-place — no table allocation per player
        local vm=is_vis and 1.0 or 0.5
        local eb=ecol_base
        ecol_v[1]=eb[1]*vm+(1-vm)*0.4
        ecol_v[2]=eb[2]*vm+(1-vm)*0.4
        ecol_v[3]=eb[3]*vm+(1-vm)*0.4
        ecol_v[4]=pa

        local hp_frac=math.max(0,math.min(1,(p.Health or 100)/(p.MaxHealth or 100)))
        local low_hp=hp_frac<0.3
        local is_prio=prio_name and p.Name==prio_name

        -- BOX
        if do_box and b_valid then
            local style=box_style
            local bc=ecol_v
            if low_hp and do_lhp then
                local pp=0.5+math.sin(t*pulse_spd*2.5)*0.5
                bc={1,0.22,0.22,pa*(0.5+pp*0.5)}
            end
            glow_rect(b.x,b.y,b.w,b.h,{bc[1],bc[2],bc[3],pa*0.55},2.5)
            if style==1 then
                draw.Rect(b.x,b.y,b.w,b.h,bc,0,thick)
            elseif style==2 then
                local cx2=b.w*0.26 local cy2=b.h*0.26
                local x1,y1,x2,y2=b.x,b.y,b.x+b.w,b.y+b.h
                draw.Line(x1,y1,x1+cx2,y1,bc,thick) draw.Line(x1,y1,x1,y1+cy2,bc,thick)
                draw.Line(x2,y1,x2-cx2,y1,bc,thick) draw.Line(x2,y1,x2,y1+cy2,bc,thick)
                draw.Line(x1,y2,x1+cx2,y2,bc,thick) draw.Line(x1,y2,x1,y2-cy2,bc,thick)
                draw.Line(x2,y2,x2-cx2,y2,bc,thick) draw.Line(x2,y2,x2,y2-cy2,bc,thick)
            elseif style==3 then
                draw.RectFilled(b.x,b.y,b.w,b.h,{bc[1],bc[2],bc[3],pa*0.10})
                draw.Rect(b.x,b.y,b.w,b.h,bc,0,thick)
            elseif style==4 then
                draw.RectFilled(b.x,b.y,b.w,b.h,{bc[1],bc[2],bc[3],pa*0.22})
            elseif style==5 then
                local cr=math.max(b.w,b.h)*0.55
                glow_line(b.x+b.w*0.5,b.y,b.x+b.w*0.5,b.y,{bc[1],bc[2],bc[3],pa},cr*0.18)
                draw.Circle(b.x+b.w*0.5,b.y+b.h*0.5,cr,bc,48,thick)
            elseif style==6 then
                local pts=get_3d_box_pts(p)
                if pts then for i=1,4 do local n=i%4+1
                    glow_line(pts[i][1],pts[i][2],pts[n][1],pts[n][2],bc,1.5)
                    glow_line(pts[i+4][1],pts[i+4][2],pts[n+4][1],pts[n+4][2],bc,1.5)
                    glow_line(pts[i][1],pts[i][2],pts[i+4][1],pts[i+4][2],bc,1.5)
                    draw.Line(pts[i][1],pts[i][2],pts[n][1],pts[n][2],bc,thick)
                    draw.Line(pts[i+4][1],pts[i+4][2],pts[n+4][1],pts[n+4][2],bc,thick)
                    draw.Line(pts[i][1],pts[i][2],pts[i+4][1],pts[i+4][2],bc,thick)
                end end
            elseif style==7 then
                local pts=get_3d_box_pts(p)
                if pts then draw_3d_corner_box(pts,bc,thick) end
            end
        end

        if do_3dbox and b_valid then
            local pts=get_3d_box_pts(p)
            if pts then draw_3d_corner_box(pts,{ecol_v[1],ecol_v[2],ecol_v[3],pa*0.7},thick) end
        end

        -- Priority ring
        if is_prio and b_valid then
            local pulse=0.65+math.sin(t*pulse_spd)*0.35
            local pr=math.max(b.w,b.h)*0.58*pulse
            draw.Circle(b.x+b.w*0.5,b.y+b.h*0.5,pr+3,{1,0.9,0.1,pa*0.2},32,4)
            draw.Circle(b.x+b.w*0.5,b.y+b.h*0.5,pr,{1,0.9,0.1,pa*pulse*0.95},48,1.5)
        end

        -- HEALTH BAR
        if do_hbar and b_valid then
            local bx=b.x-7 local by=b.y local bh2=b.h
            draw.RectFilled(bx,by,3,bh2,{0,0,0,pa*0.65},2)
            local hr=math.min(1,(1-hp_frac)*2) local hg=math.min(1,hp_frac*2)
            local hfh=bh2*hp_frac
            if hfh>1 then
                draw.RectFilled(bx,by+(bh2-hfh),3,hfh,{hr,hg,0.1,pa*0.9},2)
                draw.Line(bx,by+(bh2-hfh),bx+3,by+(bh2-hfh),{1,1,0.5,pa*0.5},1)
            end
        end

        -- HEAD DOT
        if do_hdot then
            local hx2,hy2,hv=p:GetBoneScreen("Head")
            if hv then
                local r=hdot_r
                draw.Circle(hx2,hy2,r+2.5,{ecol_v[1],ecol_v[2],ecol_v[3],pa*0.25},16,2.5)
                if hdot_fill then
                    draw.CircleFilled(hx2,hy2,r,ecol_v)
                    draw.Circle(hx2,hy2,r,{0,0,0,pa*0.5},12,1)
                else
                    draw.Circle(hx2,hy2,r,ecol_v,16,thick)
                end
            end
        end

        -- NAME
        if do_name and b_valid then
            local fsz=name_sz
            local tw=draw.GetTextSize(p.Name,fsz)
            local tx=b.x+b.w*0.5-tw*0.5 local ty=b.y-fsz-4
            draw.RectFilled(tx-4,ty-1,tw+8,fsz+2,{0,0,0,pa*0.55},3)
            otext(tx,ty,p.Name,ecol_v,fsz)
        end

        -- DISTANCE
        if do_dist and b_valid then
            local dtxt=DIST_CACHE[dist_m]
            if not dtxt then dtxt=dist_m.."m"; DIST_CACHE[dist_m]=dtxt end
            local tw=draw.GetTextSize(dtxt,10)
            local tx=b.x+b.w*0.5-tw*0.5 local ty=b.y+b.h+4
            draw.RectFilled(tx-3,ty-1,tw+6,12,{0,0,0,pa*0.45},2)
            otext(tx,ty,dtxt,{ecol_v[1],ecol_v[2],ecol_v[3],pa*0.85},10)
        end

        -- WEAPON
        if do_weapon and b_valid then
            local wname=p.ToolName
            if wname and wname~="" then
                local tw=draw.GetTextSize(wname,10)
                local tx=b.x+b.w*0.5-tw*0.5 local ty=b.y+b.h+16
                draw.RectFilled(tx-3,ty-1,tw+6,12,{0,0,0,pa*0.45},2)
                otext(tx,ty,wname,{ecol_v[1]*0.8+0.2,ecol_v[2]*0.8+0.2,ecol_v[3]*0.8+0.2,pa*0.75},10)
            end
        end

        -- SNAPLINES
        if do_snap and b_valid then
            local ox,oy
            if snap_origin==1 then ox,oy=scx,scy elseif snap_origin==2 then ox,oy=scx,sh else ox,oy=scx,0 end
            local sthick=snap_thick
            glow_line(ox,oy,b.x+b.w*0.5,b.y+b.h,{ecol_v[1],ecol_v[2],ecol_v[3],pa*0.4},sthick)
            draw.Line(ox,oy,b.x+b.w*0.5,b.y+b.h,{ecol_v[1],ecol_v[2],ecol_v[3],pa*0.65},sthick)
        end

        -- VIS DOT
        if b_valid then
            local vic=is_vis and {0.2,1,0.45,pa} or {1,0.3,0.3,pa*0.5}
            draw.CircleFilled(b.x+b.w-3,b.y+3,3.5,vic)
            draw.Circle(b.x+b.w-3,b.y+3,3.5,{0,0,0,pa*0.55},8,1)
        end

        -- SKELETON
        if do_bones then
            local bthick=bone_thick
            local bc2=esp_col(bcol_base,pa)
            local jc=esp_col(jcol_base,pa)
            local jr=joint_r
            local jfill=joint_fill
            local do_jnt=do_joints
            local joint_pts={}
            for _,pair in ipairs(BONE_PAIRS) do
                local ax,ay,av=p:GetBoneScreen(pair[1])
                local bx2,by2,bv=p:GetBoneScreen(pair[2])
                if av and bv then
                    glow_line(ax,ay,bx2,by2,{bc2[1],bc2[2],bc2[3],bc2[4]*0.35},bthick+1)
                    draw.Line(ax,ay,bx2,by2,bc2,bthick)
                    if do_jnt then joint_pts[pair[1]]={ax,ay}; joint_pts[pair[2]]={bx2,by2} end
                end
            end
            if do_jnt then
                for _,jp in pairs(joint_pts) do
                    draw.Circle(jp[1],jp[2],jr+2,{jc[1],jc[2],jc[3],jc[4]*0.28},10,2.5)
                    if jfill then draw.CircleFilled(jp[1],jp[2],jr,jc)
                    else draw.Circle(jp[1],jp[2],jr,jc,12,thick) end
                end
            end
        end

        -- THREAT BAR
        if do_threat and b_valid then
            local tc2=THREAT_CACHE[p.Name]
            if tc2 then
                local level=tc2.level or 0
                local tcol=THREAT_COLORS[level+1] or {0.5,0.5,0.5,1}
                local bar_h=math.max(4,b.h*(level/4))
                draw.RectFilled(b.x+b.w+4,b.y+b.h-bar_h,4,bar_h,{tcol[1],tcol[2],tcol[3],pa*0.85},2)
                if level>=3 then otext(b.x+b.w+10,b.y+2,THREAT_LABELS[level+1] or "",{tcol[1],tcol[2],tcol[3],pa},9) end
            end
        end

        -- CROUCH / SPRINT
        if do_crouch and b_valid then
            if (p.HipHeight or 0)<0.5 then otext(b.x+b.w+6,b.y+b.h*0.5-5,"[C]",{0.9,0.9,0.2,pa},10) end
        end
        if do_sprint and b_valid then
            if (p.WalkSpeed or 16)>20 then otext(b.x+b.w+6,b.y+b.h*0.5+6,"[S]",{0.2,0.9,0.9,pa},10) end
        end

        -- CAMERA DOT
        if ui.vals["esp_camera_dot"] then
            local lv=p.LookVector local hpos=p.HeadPosition
            if lv and hpos then
                local fx=hpos.X+lv.X*5 local fy=hpos.Y+lv.Y*5 local fz=hpos.Z+lv.Z*5
                local cx2,cy2,cv=draw.WorldToScreen(fx,fy,fz)
                if cv then
                    draw.Circle(cx2,cy2,5,{1,0.8,0.2,pa*0.8},12,1.5)
                    draw.CircleFilled(cx2,cy2,2.5,{1,0.9,0.4,pa})
                end
            end
        end

        -- VELOCITY ARROW
        if do_vel and b_valid then
            local vel=p.Velocity
            if vel then
                local vlen=math.sqrt(vel.X*vel.X+vel.Z*vel.Z)
                if vlen>1 then
                    local nx,nz=vel.X/vlen,vel.Z/vlen
                    local hpos=p.Position
                    if hpos then
                        local tsx,tsy,tv=draw.WorldToScreen(hpos.X+nx*5,hpos.Y,hpos.Z+nz*5)
                        if tv then
                            local bx2=b.x+b.w*0.5 local by2=b.y+b.h
                            local arlen=math.min(vlen*2,38)
                            local adx=tsx-bx2 local ady=tsy-by2
                            local al=math.sqrt(adx*adx+ady*ady)
                            if al>0.5 then
                                adx=adx/al*arlen ady=ady/al*arlen
                                local ac={0.35,1,0.55,pa}
                                glow_line(bx2,by2,bx2+adx,by2+ady,ac,1.5)
                                draw.Line(bx2,by2,bx2+adx,by2+ady,ac,1.5)
                                local px=-ady*0.28 local py=adx*0.28
                                draw.Line(bx2+adx,by2+ady,bx2+adx*0.65+px,by2+ady*0.65+py,ac,1.5)
                                draw.Line(bx2+adx,by2+ady,bx2+adx*0.65-px,by2+ady*0.65-py,ac,1.5)
                            end
                        end
                    end
                end
            end
        end

        -- AIM PRED DOT
        if do_pred and b_valid then
            local vel=p.Velocity local hpos=p.HeadPosition
            if vel and hpos then
                local tsx,tsy,tv=draw.WorldToScreen(hpos.X+vel.X*0.1,hpos.Y+vel.Y*0.1,hpos.Z+vel.Z*0.1)
                if tv then
                    draw.Circle(tsx,tsy,7,{1,0.5,0,pa*0.45},12,1)
                    draw.CircleFilled(tsx,tsy,4,{1,0.55,0.1,pa})
                    draw.Circle(tsx,tsy,4,{0,0,0,pa*0.45},8,1)
                end
            end
        end

        -- FOOTPRINTS
        if ui.vals["esp_footprints"] then
            local fpos=p.Position
            if fpos then
                if not ESP_FOOTPRINTS[p.Name] then ESP_FOOTPRINTS[p.Name]={} end
                local trail=ESP_FOOTPRINTS[p.Name]
                local last=trail[#trail]
                if not last or math.abs(fpos.X-(last.wx or 0))>1 or math.abs(fpos.Z-(last.wz or 0))>1 then
                    trail[#trail+1]={wx=fpos.X,wy=fpos.Y,wz=fpos.Z,t=t}
                end
                local max_n=footprint_n
                while #trail>max_n do table.remove(trail,1) end
                for i,fp in ipairs(trail) do
                    local age=t-fp.t
                    if age<6 then
                        local fpx,fpy,fpv=draw.WorldToScreen(fp.wx,fp.wy,fp.wz)
                        if fpv then
                            local fa=(1-age/6)*(i/#trail)*pa*0.8
                            if fa>0.05 then
                                draw.Circle(fpx,fpy,3,{ecol_v[1],ecol_v[2],ecol_v[3],fa*0.4},8,1)
                                draw.CircleFilled(fpx,fpy,2,{ecol_v[1],ecol_v[2],ecol_v[3],fa})
                            end
                        end
                    end
                end
            end
        end

        -- LKP UPDATE
        if do_lkp and b_valid then
            ESP_LAST_POS[p.Name]={x=b.x,y=b.y,w=b.w,h=b.h,t=t}
        end

        -- OFF-SCREEN ARROW
        if ui.vals["esp_offscreen"] then
            if not b_valid then
                local hpos=p.HeadPosition or p.Position
                if hpos then
                    local tsx,tsy,tv=draw.WorldToScreen(hpos.X,hpos.Y,hpos.Z)
                    if not tv then
                        local adx=(tsx or scx)-scx local ady=(tsy or scy)-scy
                        local al=math.sqrt(adx*adx+ady*ady)
                        if al>0.1 then
                            adx,ady=adx/al,ady/al
                            local edge_r=offscreen_r
                            local ex=math.max(edge_r,math.min(sw-edge_r,scx+adx*(sw*0.5-edge_r)))
                            local ey=math.max(edge_r,math.min(sh-edge_r,scy+ady*(sh*0.5-edge_r)))
                            local ar=11
                            local px3=-ady*ar*0.5 local py3=adx*ar*0.5
                            local pts={{ex+adx*ar,ey+ady*ar},{ex-adx*ar*0.3+px3,ey-ady*ar*0.3+py3},{ex-adx*ar*0.3-px3,ey-ady*ar*0.3-py3}}
                            draw.CircleFilled(ex,ey,8,{ecol_v[1],ecol_v[2],ecol_v[3],pa*0.2})
                            draw.PolyFilled(pts,{ecol_v[1],ecol_v[2],ecol_v[3],pa*0.9})
                        end
                    end
                end
            else
                squad_pts[#squad_pts+1]={x=b.x+b.w*0.5,y=b.y+b.h*0.5}
            end
        elseif b_valid then
            squad_pts[#squad_pts+1]={x=b.x+b.w*0.5,y=b.y+b.h*0.5}
        end

        ::epcont::
    end

    -- SQUAD LINES
    if do_squad and #squad_pts>1 then
        local lc={ecol_base[1],ecol_base[2],ecol_base[3],g_alpha*0.2}
        for i=1,#squad_pts do
            for j=i+1,#squad_pts do
                draw.Line(squad_pts[i].x,squad_pts[i].y,squad_pts[j].x,squad_pts[j].y,lc,1)
            end
        end
    end

    -- KILL ICONS
    if ui.vals["esp_kill_icon"] then
        local keep={}
        for _,ki in ipairs(ESP_KILL_ICONS) do
            local age=t-ki.t
            if age<3 then
                local fa=(1-age/3)*g_alpha
                local pulse=0.7+math.sin(t*8)*0.3
                draw.Circle(ki.x,ki.y,11*pulse,{1,0.2,0.2,fa*0.5},12,2)
                otext(ki.x-4,ki.y-6,"X",{1,0.35,0.35,fa},14)
                keep[#keep+1]=ki
            end
        end
        ESP_KILL_ICONS=keep
    end
end

