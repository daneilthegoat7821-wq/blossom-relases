local function draw_disclaimer()
    if ui.disclaimer_accepted then return false end

    local sw, sh = draw.GetScreenSize()
    DISC_APPEAR = DISC_APPEAR + utility.GetDeltaTime() * 6
    if DISC_APPEAR > 1 then DISC_APPEAR = 1 end
    local ea = ease_out(DISC_APPEAR)

    -- Full screen dark overlay
    draw.RectFilled(0, 0, sw, sh, {0, 0, 0, 0.88 * ea})

    -- Modal dimensions
    local mw, mh = 680, 560
    local mx = sw * 0.5 - mw * 0.5
    local my = sh * 0.5 - mh * 0.5 + (1-ea) * 30

    -- Modal background
    soft(mx, my, mw, mh, _BLK_FULL, theme.round, 12, 0.6)
    draw.RectFilled(mx-1, my-1, mw+2, mh+2, a(theme.line, ea), theme.round+1)
    draw.RectFilled(mx, my, mw, mh, a(theme.base, ea), theme.round)

    -- Accent top strip
    draw.RectFilled(mx+theme.round, my, mw-theme.round*2, 2, {0.96,0.36,0.56, ea*0.9})

    -- Header
    local hx = mx + mw*0.5
    draw.Text(hx - draw.GetTextSize("BLOSSOM v4.0", 22)*0.5, my+16,
        "BLOSSOM v4.0", {0.96,0.36,0.56, ea}, 22)
    draw.Text(hx - draw.GetTextSize("READ BEFORE CONTINUING", 11)*0.5, my+42,
        "READ BEFORE CONTINUING", {0.6,0.6,0.6, ea*0.8}, 11)

    -- Divider
    draw.Line(mx+20, my+60, mx+mw-20, my+60, a(theme.line, ea*0.8), 1)

    -- Scrollable warning content area
    local content_y   = my + 68
    local content_h   = mh - 68 - 90  -- leave space for checkbox + button
    local content_x   = mx + 20
    local content_w   = mw - 40

    -- Clip-aware item render — only draw items within the visible band
    local iy = content_y - DISC_SCROLL
    local total_h = 0
    local items_drawn = {}
    for _, w in ipairs(DISC_WARNINGS) do
        local lines = {}
        -- Word wrap at content_w - 24 (icon space)
        local max_w = content_w - 28
        local words = {}
        for word in w.text:gmatch("%S+") do words[#words+1] = word end
        local line = ""
        for _, word in ipairs(words) do
            local test = line == "" and word or line.." "..word
            if draw.GetTextSize(test, 11) > max_w then
                lines[#lines+1] = line
                line = word
            else
                line = test
            end
        end
        if line ~= "" then lines[#lines+1] = line end

        local item_h = #lines * 14 + 8
        items_drawn[#items_drawn+1] = {iy=iy, w=w, lines=lines, item_h=item_h}
        iy = iy + item_h
        total_h = total_h + item_h
    end

    -- Draw visible items
    local max_scroll = math.max(0, total_h - content_h)
    for _, item in ipairs(items_drawn) do
        local wy = item.iy
        if wy + item.item_h > content_y - 2 and wy < content_y + content_h + 2 then
            -- Icon
            if item.w.icon == "!" or item.w.icon == "⚠" then
                draw.Text(content_x, wy + 2, item.w.icon, {item.w.col[1],item.w.col[2],item.w.col[3], ea}, 12)
            else
                draw.Text(content_x, wy + 3, item.w.icon, {item.w.col[1],item.w.col[2],item.w.col[3], ea*0.7}, 10)
            end
            -- Text lines
            for li, line in ipairs(item.lines) do
                local ly = wy + (li-1)*14
                if ly >= content_y - 2 and ly < content_y + content_h + 2 then
                    draw.Text(content_x+18, ly+2, line,
                        {item.w.col[1]*0.85+0.15, item.w.col[2]*0.85+0.15, item.w.col[3]*0.85+0.15, ea*0.9}, 11)
                end
            end
        end
    end

    -- Fade gradient at top and bottom of scroll area
    draw.RectFilled(content_x-2, content_y, content_w+4, 14,
        {theme.base[1],theme.base[2],theme.base[3], ea*0.85})
    draw.RectFilled(content_x-2, content_y+content_h-14, content_w+4, 14,
        {theme.base[1],theme.base[2],theme.base[3], ea*0.85})

    -- Scrollbar
    if total_h > content_h then
        local sb_h = math.max(30, content_h * (content_h/total_h))
        local sb_y = content_y + (content_h-sb_h) * (DISC_SCROLL/max_scroll)
        draw.RectFilled(mx+mw-10, content_y, 4, content_h, a(theme.rail, ea*0.4), 2)
        draw.RectFilled(mx+mw-10, sb_y, 4, sb_h, {0.96,0.36,0.56, ea*0.7}, 2)

        -- Scroll via drag on scroll area
        local in_content = inside(content_x, content_y, content_w, content_h)
        if in_content and ui.mouse.clicked then
            ui.drag = {kind="disc_scroll", oy=ui.mouse.y, start=DISC_SCROLL}
        end
        if ui.drag and ui.drag.kind=="disc_scroll" then
            DISC_SCROLL = clamp(ui.drag.start + (ui.mouse.y - ui.drag.oy) * 2, 0, max_scroll)
        end
    end

    -- Bottom section divider
    local bot_y = my + mh - 88
    draw.Line(mx+20, bot_y, mx+mw-20, bot_y, a(theme.line, ea*0.6), 1)

    -- "I understand all of the above" checkbox
    local cb_x, cb_y = mx+22, bot_y+12
    local cb_size = 14
    local cb_hot = inside(cb_x, cb_y, cb_size+120, cb_size)
    local cb_hv  = approach("disc_cb", cb_hot and 1 or 0, 14)
    draw.RectFilled(cb_x, cb_y, cb_size, cb_size,
        {theme.field[1]+cb_hv*0.1, theme.field[2]+cb_hv*0.1, theme.field[3]+cb_hv*0.1, ea}, 3)
    draw.Rect(cb_x, cb_y, cb_size, cb_size,
        {0.4+cb_hv*0.3, 0.4+cb_hv*0.3, 0.4+cb_hv*0.3, ea}, 0, 1)
    if DISC_CHECKED then
        -- Checkmark
        draw.Line(cb_x+3, cb_y+7, cb_x+6, cb_y+10, {0.96,0.36,0.56, ea}, 1.5)
        draw.Line(cb_x+6, cb_y+10, cb_x+11, cb_y+4, {0.96,0.36,0.56, ea}, 1.5)
    end
    if cb_hot and ui.mouse.clicked then
        DISC_CHECKED = not DISC_CHECKED
        ui.mouse.clicked = false
    end
    local cb_col = DISC_CHECKED and {0.9,0.9,0.9,ea} or {0.5,0.5,0.5,ea}
    draw.Text(cb_x+cb_size+8, cb_y+2,
        "I understand all of the above and accept full responsibility", cb_col, 11)

    -- ACCEPT button
    local btn_w, btn_h = 180, 34
    local btn_x = mx + mw*0.5 - btn_w*0.5
    local btn_y = bot_y + 38
    local btn_hot = inside(btn_x, btn_y, btn_w, btn_h) and DISC_CHECKED
    DISC_BTN_HOV = approach("disc_btn", btn_hot and 1 or 0, 16)

    local btn_alpha = DISC_CHECKED and (0.65 + DISC_BTN_HOV*0.35) or 0.25
    local btn_r = 0.96; local btn_g = 0.36 + DISC_BTN_HOV*0.1; local btn_b = 0.56
    draw.RectFilled(btn_x, btn_y, btn_w, btn_h,
        {btn_r, btn_g, btn_b, ea*btn_alpha}, theme.round-2)

    if DISC_CHECKED then
        -- Glow behind button
        draw.RectFilled(btn_x-3, btn_y-3, btn_w+6, btn_h+6,
            {btn_r, btn_g, btn_b, ea*0.08*DISC_BTN_HOV}, theme.round+1)
        draw.Rect(btn_x, btn_y, btn_w, btn_h,
            {btn_r, btn_g, btn_b, ea*(0.4+DISC_BTN_HOV*0.4)}, 0, 1)
    end

    local btn_label = "ACCEPT & CONTINUE"
    local bl_w = draw.GetTextSize(btn_label, 12)
    local btn_col = DISC_CHECKED and {1,1,1,ea} or {0.4,0.4,0.4,ea}
    draw.Text(btn_x+btn_w*0.5-bl_w*0.5, btn_y+btn_h*0.5-7, btn_label, btn_col, 12)

    -- Click handler
    if btn_hot and ui.mouse.clicked and DISC_CHECKED then
        ui.disclaimer_accepted = true
        ui.mouse.clicked = false
        -- Open the menu automatically after acceptance
        ui.open = true
        notify.Success("Blossom v4.0", "Loaded. Stay safe out there.", 4)
    end

    -- "DECLINE" small text link
    local dec_txt = "Decline (close script)"
    local dec_w = draw.GetTextSize(dec_txt, 10)
    local dec_x = mx + mw*0.5 - dec_w*0.5
    local dec_y = btn_y + btn_h + 8
    local dec_hot = inside(dec_x-4, dec_y-2, dec_w+8, 14)
    local dec_hv  = approach("disc_dec", dec_hot and 1 or 0, 14)
    draw.Text(dec_x, dec_y, dec_txt,
        {0.35+dec_hv*0.25, 0.35+dec_hv*0.25, 0.35+dec_hv*0.25, ea*(0.45+dec_hv*0.3)}, 10)
    if dec_hot and ui.mouse.clicked then
        -- Just close — script stays loaded but UI never opens
        ui.disclaimer_accepted = false
        -- Prevent further drawing by setting a declined flag
        ui.vals["_disc_declined"] = true
        ui.mouse.clicked = false
    end

    return true  -- returning true = disclaimer still showing, block UI
end

