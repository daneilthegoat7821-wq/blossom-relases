local function draw_overlays(t)
    if ui.vals["st_mark"] then
        local sw=utility.GetScreenSize()
        local txt="BLOSSOM   fps "..math.floor(utility.GetFPS()).."   up "..math.floor(t).."s   features 0"
        local tw=tsize(txt,11)
        local wx = sw-tw-24-14
        soft(wx,44,tw+24,24,_BLK_FULL,8,3,0.4)
        draw.RectFilled(wx,44,tw+24,24, a(theme.base,0.97),8)
        draw.Rect(wx,44,tw+24,24, a(theme.line,1),8,1)
        draw.RectFilled(wx,44,2,24, a(theme.accent,1),1)
        tmid(wx+12,44,24,txt, a(theme.text,0.95),11)
    end
    if ui.vals["st_keylist"] then
        local rows={}
        local function add(id,lbl) if (ui.binds[id] or 0)~=0 then rows[#rows+1]={lbl,vk_name(ui.binds[id])} end end
        add("aim_key","Silent Aim"); add("trig_key","Triggerbot")
        add("mv_flykey","Flight"); add("st_menukey","Menu")
        if #rows>0 then
            local pw,rh=168,20
            local ph=28+#rows*rh+4
            local ky=44
            soft(14,ky,pw,ph,_BLK_FULL,theme.round,3,0.35)
            draw.RectFilled(14,ky,pw,ph, a(theme.base,0.97),theme.round)
            draw.Rect(14,ky,pw,ph, a(theme.line,1),theme.round,1)
            draw.RectFilled(14,ky,2,ph, a(theme.accent,1),1)
            tmid(24,ky,26,"KEYBINDS", a(theme.text,0.9),11)
            draw.Line(22,ky+26,pw+2,ky+26, a(theme.line,1),1)
            for i,r in ipairs(rows) do
                local ry=ky+30+(i-1)*rh
                tmid(24,ry,rh,r[1], a(theme.sub,1),11)
                local cw=tsize(r[2],10)+10
                draw.RectFilled(14+pw-cw-10,ry+3,cw,14, a(theme.field,1),4)
                tmid(14+pw-cw-5,ry+3,14,r[2], a(theme.text,0.85),10)
            end
        end
    end
    -- fake FOV circle uses its own custom color now
    if ui.vals["fov_show"] then
        local cx,cy=input.GetScreenCenter()
        draw.Circle(cx,cy,ui.vals["fov_size"], raw(ui.colors["_fov"],0.85),80,1.5)
    end
end

