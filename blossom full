local function w_button(it,x,y,w,ap)
    local top=BASE_ROW.button
    local bh=24
    local by=y+(top-bh)*0.5
    local hot=inside(x,by,w,bh) and interactable(ap)
    local key=it._hov_key or (WGT_BT_PREFIX..it.id)
    it._hov_key=key  -- cache on first call, never recomputes
    local hv=approach(key, hot and 1 or 0, 14)
    local lift=by-hv*1.0
    if hv>0.01 then soft(x,lift,w,bh,theme.accent,6,3,ap) end
    draw.RectFilled(x,lift,w,bh, a(mix(theme.field,theme.accent,hv*0.30),ap),6)
    draw.Rect(x,lift,w,bh, a(theme.accent, ap*(0.35+hv*0.5)),6,1)
    local tw=tsize(it.label,12)
    tmid(x+(w-tw)*0.5,lift,bh,it.label, a(theme.text,ap),12)
    if hot and ui.mouse.clicked then
        ui.mouse.clicked = false
        -- ── PRESET: Underground Best ─────────────────────────
        if it.id == "preset_ug_best" then
            ui.vals["ug_depth"]     = 4
            ui.vals["mv_fly"]       = true
            ui.vals["bs_fly_speed"] = 27
            GC_DIRTY = true
            notify.Success("Preset", "Underground Best applied — crouch to enter buildings", 4)
        -- ── PRESET: Legit Underground ─────────────────────────
        elseif it.id == "preset_ug_legit" then
            ui.vals["ug_depth"]     = 2
            ui.vals["mv_fly"]       = true
            ui.vals["bs_fly_speed"] = 25
            GC_DIRTY = true
            notify.Success("Preset", "Legit Underground applied", 3)
        -- ── CONFIG BUTTONS ───────────────────────────────────
        elseif it.id == "cfg_save" then
            local slot = math.floor(fvn("cfg_slot") or 1)
            local key  = "blossom_cfg_"..slot
            local data = {}
            for k,v in pairs(ui.vals) do data[k]=v end
            pcall(function() savedata(key, data) end)
            notify.Success("Config", "Profile "..slot.." saved", 2)
        elseif it.id == "cfg_load" then
            local slot = math.floor(fvn("cfg_slot") or 1)
            local key  = "blossom_cfg_"..slot
            pcall(function()
                local data = loaddata(key)
                if data then
                    for k,v in pairs(data) do ui.vals[k]=v end
                    GC_DIRTY = true
                    notify.Success("Config", "Profile "..slot.." loaded", 2)
                else
                    notify.Warning("Config", "No saved profile "..slot, 2)
                end
            end)
        elseif it.id == "cfg_reset" then
            for k in pairs(ui.vals) do ui.vals[k]=nil end
            GC_DIRTY = true
            notify.Success("Config", "Reset to defaults", 2)
        elseif it.id == "cfg_export" then
            pcall(function()
                local parts = {}
                for k,v in pairs(ui.vals) do
                    parts[#parts+1] = k.."="..tostring(v)
                end
                setclipboard(table.concat(parts, ";"))
                notify.Success("Config", "Exported to clipboard", 2)
            end)
        elseif it.id == "cfg_import" then
            pcall(function()
                local clip = getclipboard()
                if clip then
                    for pair in clip:gmatch("[^;]+") do
                        local k,v = pair:match("([^=]+)=(.*)")
                        if k then
                            if v=="true" then ui.vals[k]=true
                            elseif v=="false" then ui.vals[k]=false
                            else ui.vals[k]=tonumber(v) or v end
                        end
                    end
                    GC_DIRTY = true
                    notify.Success("Config", "Imported from clipboard", 2)
                end
            end)
        else
            log("Button '"..it.id.."' pressed")
        end
    end
    return top
end

