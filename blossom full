-- GC / WEAPON MODS
-- =============================================================
GC_INITED   = false
GC_DIRTY    = true   -- true = settings changed, need to reapply
GC_PREV     = {}     -- snapshot of last-applied settings
GC_KEYS = {"RecoilMult","AimSpreadMult","HipSpreadMult","SwayCycleX","SwayCycleY",
                 "FireTime","Damage","Ammo","BobAmplitude"}

-- Track which weapon-mod toggles matter so we only reapply on change
WM_WATCH = {"bs_no_recoil","bs_no_spread","bs_no_sway","bs_no_bobbing",
                  "bs_no_muzzle","bs_rapid_fire","bs_double_tap","bs_instant_bullet",
                  "bs_instant_aim","bs_instant_equip","bs_unlock_modes","bs_no_obstruct"}

local function run_weapon_mods()
    if not GC_INITED then
        pcall(refreshgc)
        GC_INITED = true
        GC_DIRTY  = true
    end

    -- Check if any weapon mod toggle changed since last frame
    if not GC_DIRTY then
        for _,k in ipairs(WM_WATCH) do
            if sg(k) ~= GC_PREV[k] then GC_DIRTY = true; break end
        end
    end
    if not GC_DIRTY then return end  -- nothing changed — skip all applygc calls

    -- Snapshot current state
    for _,k in ipairs(WM_WATCH) do GC_PREV[k] = sg(k) end
    GC_DIRTY = false

    -- applygc(key, value) per-pair — most reliable form
    if sg("bs_no_recoil") then
        pcall(applygc, "RecoilMult",      0)
        pcall(applygc, "AimForRecoilMult",false)
        pcall(applygc, "RecoilSpring",    0)
        pcall(applygc, "VerticalRecoil",  0)
        pcall(applygc, "HorizontalRecoil",0)
    end
    if sg("bs_no_spread") then
        pcall(applygc, "AimSpreadMult",   0)
        pcall(applygc, "HipSpreadMult",   0)
        pcall(applygc, "SpreadMultiplier",0)
        pcall(applygc, "Spread",          0)
    end
    if sg("bs_no_sway") then
        pcall(applygc, "SwayCycleX", 0)
        pcall(applygc, "SwayCycleY", 0)
        pcall(applygc, "SwayAmount", 0)
        pcall(applygc, "SwayMult",   0)
    end
    if sg("bs_no_bobbing") then
        pcall(applygc, "BobAmplitude", 0)
        pcall(applygc, "BobSpeed",     0)
        pcall(applygc, "BobMult",      0)
    end
    if sg("bs_no_muzzle") then
        pcall(applygc, "MuzzleFlash",  false)
        pcall(applygc, "ShowMuzzle",   false)
    end
    if sg("bs_rapid_fire") then
        pcall(applygc, "FireTime",  0.01)
        pcall(applygc, "FireDelay", 0.01)
        pcall(applygc, "RPM",       9999)
    elseif sg("bs_double_tap") then
        pcall(applygc, "FireTime",  0.001)
        pcall(applygc, "FireDelay", 0.001)
    end
    if sg("bs_instant_bullet") then
        pcall(applygc, "BulletSpeed",  99999)
        pcall(applygc, "MuzzleVelocity",99999)
    end
    if sg("bs_instant_aim") then
        pcall(applygc, "AimTime",   0)
        pcall(applygc, "RaiseSpeed",0)
    end
    if sg("bs_instant_equip") then
        pcall(applygc, "EquipTime", 0)
        pcall(applygc, "UnequipTime",0)
    end
    if sg("bs_unlock_modes") then
        pcall(applygc, "Auto",      true)
        pcall(applygc, "SemiAuto",  true)
        pcall(applygc, "Burst",     true)
    end
    if sg("bs_no_obstruct") then
        pcall(applygc, "ObstructionIgnored", true)
        pcall(applygc, "WallCheck",          false)
    end
end

-- =============================================================
-- MOVEMENT
-- =============================================================
UG_NOCOL_CACHE = {}
UG_NOCOL_STAMP = 0
UG_WAS_ACTIVE  = false
UG_FLOOR_Y     = nil   -- Y position when underground activated
-- Third person state lives in run_third_person() near on_frame.

local function run_movement()
    pcall(function()
        local lp   = game.LocalPlayer
        if not lp or not lp.Character then return end
        local char = lp.Character
        local hum  = char:FindFirstChild("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end

        -- ── SPEEDHACK ──────────────────────────────────────
        if sg("mv_speed") then
            local spd = math.max(1, tonumber(fvn("mv_mult")) or 50)
            hum.WalkSpeed = spd
            pcall(function() hum.WalkspeedCheck = spd end)
        else
            hum.WalkSpeed = 16
            pcall(function() hum.WalkspeedCheck = 16 end)
        end

        -- ── JUMP ──────────────────────────────────────────────
        if sg("mv_jump") then
            hum.JumpPower = 200
        elseif sg("bs_jumpjack") then
            hum.JumpPower = 120
        else
            hum.JumpPower = 50
        end

        -- ── NO FALL DAMAGE ─────────────────────────────────
        if sg("mv_nofall") then
            hum.MaxHealth = 9999
            if hum.Health < 50 then hum.Health = hum.MaxHealth end
        end

        -- ── GOD MODE ───────────────────────────────────────
        if sg("pl_god") then
            hum.MaxHealth = 9999
            hum.Health    = 9999
        end

        -- ── FLY + UNDERGROUND (single position write) ──────
        if sg("mv_fly") then
            hum.PlatformStand = true

            local ug_depth = tonumber(fvn("ug_depth")) or 0
            local speed    = tonumber(fvn("bs_fly_speed")) or 16
            local look     = camera.GetLookVector()
            -- right vector: perpendicular to look on XZ plane
            local rx, rz   = look.Z, -look.X
            local dt       = ib_dt()

            -- Input keys — A/D swapped per user request
            local fwd = input.IsKeyDown(0x57)   -- W = forward
            local bck = input.IsKeyDown(0x53)   -- S = back
            local lft = input.IsKeyDown(0x44)   -- D key = go LEFT (swapped)
            local rgt = input.IsKeyDown(0x41)   -- A key = go RIGHT (swapped)
            local up2 = input.IsKeyDown(0x20)   -- Space = rise
            local dn2 = input.IsKeyDown(0x43)   -- C = sink/toggle

            local vx = ((rgt and 1 or 0) - (lft and 1 or 0)) * speed
            local vz = ((bck and 1 or 0) - (fwd and 1 or 0)) * speed

            local pos = root.Position
            if pos then
                local nx = pos.X + look.X*(-vz)*dt + rx*vx*dt
                local nz = pos.Z + look.Z*(-vz)*dt + rz*vx*dt
                local ny

                if ug_depth > 0 then
                    -- UNDERGROUND: lock Y to exact depth, ignore vertical input
                    -- No conflict because we compute ny here and write once

                    -- Snapshot floor Y on first activation
                    if not UG_WAS_ACTIVE then
                        UG_WAS_ACTIVE = true
                        UG_FLOOR_Y    = pos.Y
                    end

                    -- Target Y is fixed — never changes after activation
                    ny = UG_FLOOR_Y - ug_depth

                    -- Kill ALL velocity so physics can't fight us
                    pcall(function()
                        root.Velocity = Vector3.New(0, 0, 0)
                    end)

                    -- No-collision cache (rebuild every 2s)
                    local now = ib_clock()
                    if now - UG_NOCOL_STAMP > 2 then
                        UG_NOCOL_CACHE = {}
                        UG_NOCOL_STAMP = now
                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") and part.Name ~= "Head" then
                                UG_NOCOL_CACHE[#UG_NOCOL_CACHE+1] = part
                            end
                        end
                    end
                    for _, part in ipairs(UG_NOCOL_CACHE) do
                        pcall(function() part.CanCollide = false end)
                    end

                else
                    -- Normal fly Y: Space rises, C sinks
                    local vy = ((up2 and 1 or 0) - (dn2 and 1 or 0)) * speed
                    ny = pos.Y + vy * dt

                    -- Exiting underground — restore collision
                    if UG_WAS_ACTIVE then
                        for _, part in ipairs(UG_NOCOL_CACHE) do
                            pcall(function() part.CanCollide = true end)
                        end
                        UG_NOCOL_CACHE = {}
                        UG_WAS_ACTIVE  = false
                        UG_FLOOR_Y     = nil
                    end
                end

                -- ONE single position write per frame, no conflicts
                local ep = entity.GetLocalPlayer()
                if ep then
                    ep.Position = Vector3.New(nx, ny, nz)
                else
                    pcall(function() root.Position = Vector3.New(nx, ny, nz) end)
                end
            end

        else
            -- Fly off — clean up everything
            if hum.PlatformStand then hum.PlatformStand = false end
            if UG_WAS_ACTIVE then
                for _, part in ipairs(UG_NOCOL_CACHE) do
                    pcall(function() part.CanCollide = true end)
                end
                UG_NOCOL_CACHE = {}
                UG_WAS_ACTIVE  = false
                UG_FLOOR_Y     = nil
            end
        end

        -- Third person is handled in run_third_person()
        -- which fires at render time inside on_frame, not here.

        -- ── FOV OVERRIDE (every frame) ─────────────────────
        if sg("bs_fov_changer") then
            local target = tonumber(fvn("pl_fov")) or 90
            pcall(camera.SetFov, target)
        end

    end)
end

