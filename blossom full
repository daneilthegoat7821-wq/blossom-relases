    elseif layout==4 then
        local r=sz+gap
        local ax,ay=rot(0,-r) local bx,by=rot(r*0.866,r*0.5) local cx2,cy2=rot(-r*0.866,r*0.5)
        draw.Line(ax,ay,bx,by,dc,th) draw.Line(bx,by,cx2,cy2,dc,th)
        draw.Line(cx2,cy2,ax,ay,fvb("xhair_animate") and col2 or dc,th)
