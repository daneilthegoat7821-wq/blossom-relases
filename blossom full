    if not me or not me.Position then return end
    local pos = me.Position
    local sx,sy,vis = draw.WorldToScreen(pos.X,pos.Y,pos.Z)
    if not vis then return end
    local t     = ib_clock()
    ORBIT_T     = t*1.6
    local style = math.floor(fvn("bs_orbit_style") or 1)-1
    local R1    = 52
    local ac    = theme.accent
    if style==0 then
        draw.Circle(sx,sy,R1,{ac[1],ac[2],ac[3],0.8},48,1.5)
    elseif style==1 then
        draw.Circle(sx,sy,R1,{ac[1],ac[2],ac[3],0.7},48,1.5)
        draw.Circle(sx,sy,R1*0.6,{ac[1],ac[2],ac[3],0.5},32,1)
    elseif style==2 then
        local p=0.65+math.sin(t*4)*0.35
        draw.Circle(sx,sy,R1*p,{ac[1],ac[2],ac[3],p*0.9},40,2)
    elseif style==3 then
        for i=0,59 do
            local a1=ORBIT_T+(i/60)*math.pi*6 local r=R1*(i/60)
            local a2=ORBIT_T+((i+1)/60)*math.pi*6 local r2=R1*((i+1)/60)
            draw.Line(sx+math.cos(a1)*r,sy+math.sin(a1)*r*0.38,sx+math.cos(a2)*r2,sy+math.sin(a2)*r2*0.38,{ac[1],ac[2],ac[3],(i/60)*0.8},1.5)
        end
    elseif style==4 then
        for p=0,5 do
            local base=ORBIT_T+p/6*math.pi*2
            for i=0,15 do
                local a1=base+i/16*math.pi/2-math.pi/4 local a2=base+(i+1)/16*math.pi/2-math.pi/4
                local r=R1*math.abs(math.cos(a1-base)) local r2=R1*math.abs(math.cos(a2-base))
                draw.Line(sx+math.cos(a1)*r,sy+math.sin(a1)*r*0.38,sx+math.cos(a2)*r2,sy+math.sin(a2)*r2*0.38,{ac[1],ac[2],ac[3],0.7},1.5)
            end
        end
    end
end

