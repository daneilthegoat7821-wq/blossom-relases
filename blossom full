-- ARM GLOW
-- =============================================================
ARM_CACHE   = nil
ARM_SCAN_T  = 0
local function run_arm_glow()
    if not sg("bs_arm_glow") then
        if ARM_CACHE then
            for _,e in ipairs(ARM_CACHE) do
                pcall(function() if e.part and e.part.parent then e.part.Transparency=e.orig end end)
            end
            ARM_CACHE = nil
        end
        return
    end
    local now   = ib_clock()
    local alpha = (tonumber(fvn("bs_arm_alpha")) or 50) / 100
    if not ARM_CACHE or now-ARM_SCAN_T>2 then
        ARM_CACHE={} ARM_SCAN_T=now
        pcall(function()
            local char=game.LocalPlayer and game.LocalPlayer.Character
            if not char then return end
            for _,p in ipairs(char:GetChildren()) do
                if p:IsA("BasePart") then ARM_CACHE[#ARM_CACHE+1]={part=p,orig=p.Transparency} end
            end
            local ok,tool=pcall(function() return char:FindFirstChildOfClass("Tool") end)
            if ok and tool then
                for _,p in ipairs(tool:GetChildren()) do
                    if p:IsA("BasePart") then ARM_CACHE[#ARM_CACHE+1]={part=p,orig=p.Transparency} end
                end
            end
        end)
    end
    -- Write transparency directly — no per-part pcall closure
    for _,e in ipairs(ARM_CACHE) do
        local ok,_ = pcall(function() e.part.Transparency = alpha end)
        if not ok then ARM_CACHE = nil; return end  -- char died/respawned, reset cache
    end
end

