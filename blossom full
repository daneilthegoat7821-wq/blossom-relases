local SOUND_OBJ=nil
local function get_sound_obj()
    if SOUND_OBJ and SOUND_OBJ.parent then return SOUND_OBJ end
    pcall(function() for _,inst in ipairs(game.Workspace:GetDescendants()) do if inst:IsA("Sound") then SOUND_OBJ=inst return end end end)
    return SOUND_OBJ
end
local function play_hit_sound(kind)
    if not sg("bs_override_hs") and kind=="headshot" then return end
    if not sg("bs_override_body") and kind=="body" then return end
    if not sg("bs_override_kill") and kind=="kill" then return end
    pcall(function() local s=get_sound_obj() if s then s.Volume=0.6 s.Playing=false s.Playing=true end end)
end

local function run_hit_detection()
    local players=entity.GetPlayers() if not players then return end
    local now=ib_clock()
    for _,p in ipairs(players) do
        if p.IsLocal then goto cont end
        if not p.IsValid then goto cont end
        local hp=p.Health if not hp then goto cont end
        local prev=HIT_HP_CACHE[p.Name] HIT_HP_CACHE[p.Name]=hp
        if prev and hp<prev and hp>0 then
            local is_head=(prev-hp)>80
            local pos=p.Position
            if pos then
                local sx,sy,vis = draw.WorldToScreen(pos.X,pos.Y+3,pos.Z)
                if vis then
                    if sg("bs_hitmarkers")     then spawn_hitmarker(sx,sy,is_head) end
                    if sg("bs_bullet_impacts") then spawn_impact(sx,sy) end
                    if sg("bs_bullet_tracers") then spawn_tracer(sx,sy) end
                    if sg("bs_hit_vfx") then
                        local cnt=math.floor(fvn("vfx_burst_count") or 8)
                        local vc=ui.colors["_vfx"] or theme.accent
                        for i=1,cnt do
                            local ang=i/cnt*math.pi*2 local spd=30+math.random()*30
                            HIT_EFFECTS[#HIT_EFFECTS+1]={type="vfx",sx=sx,sy=sy,vx=math.cos(ang)*spd,vy=math.sin(ang)*spd,born=now,dur=0.55,col={vc[1],vc[2],vc[3],1},size=3}
                        end
                    end
                end
            end
            if is_head then play_hit_sound("headshot") else play_hit_sound("body") end
        elseif prev and hp<=0 and prev>0 then
            play_hit_sound("kill") HIT_HP_CACHE[p.Name]=nil
        end
        ::cont::
    end
    -- O(1) swap-and-pop removal instead of O(n) table.remove shift
    local i=1 while i<=#HIT_EFFECTS do
        if now-HIT_EFFECTS[i].born>HIT_EFFECTS[i].dur then
            local n=#HIT_EFFECTS
            HIT_EFFECTS[i]=HIT_EFFECTS[n]; HIT_EFFECTS[n]=nil
        else i=i+1 end
    end
    local j=1 while j<=#HIT_TRACERS do
        if now-HIT_TRACERS[j].born>HIT_TRACERS[j].dur then
            local n=#HIT_TRACERS
            HIT_TRACERS[j]=HIT_TRACERS[n]; HIT_TRACERS[n]=nil
        else j=j+1 end
    end
end

local function draw_hit_effects()
    local now=ib_clock()
    if sg("bs_bullet_tracers") then
        for _,tr in ipairs(HIT_TRACERS) do
            local age=(now-tr.born)/tr.dur local alpha=(1-age)*tr.col[4]
            if alpha>0.01 then
                local thick=tr.thick or 1.5
                _RC[1]=tr.col[1] _RC[2]=tr.col[2] _RC[3]=tr.col[3]
                _RC[4]=alpha*0.25; draw.Line(tr.x1,tr.y1,tr.x2,tr.y2,_RC,thick+3)
                _RC[4]=alpha;      draw.Line(tr.x1,tr.y1,tr.x2,tr.y2,_RC,thick)
            end
        end
    end
    for _,e in ipairs(HIT_EFFECTS) do
        local age=(now-e.born)/e.dur local alpha=1-age
        if e.type=="hitmarker" and sg("bs_hitmarkers") then
            local sz=e.size or 8 local st=e.style or 1 local al=alpha*0.95
            local col={e.col[1],e.col[2],e.col[3],al} local gc={e.col[1],e.col[2],e.col[3],al*0.25}
            if st==1 then
                draw.Line(e.sx-sz,e.sy-sz,e.sx+sz,e.sy+sz,col,2) draw.Line(e.sx+sz,e.sy-sz,e.sx-sz,e.sy+sz,col,2)
                draw.Line(e.sx-sz,e.sy-sz,e.sx+sz,e.sy+sz,gc,5)  draw.Line(e.sx+sz,e.sy-sz,e.sx-sz,e.sy+sz,gc,5)
            elseif st==2 then
                draw.Line(e.sx-sz,e.sy,e.sx+sz,e.sy,col,2) draw.Line(e.sx,e.sy-sz,e.sx,e.sy+sz,col,2)
            elseif st==3 then
                draw.CircleFilled(e.sx,e.sy,sz*0.4,col,10)
            elseif st==4 then
                draw.Circle(e.sx,e.sy,sz,col,20,2)
            end
        elseif e.type=="impact" and sg("bs_bullet_impacts") then
            local dt2=now-e.born local px=e.sx+e.vx*dt2 local py=e.sy+e.vy*dt2
            local col=e.col draw.CircleFilled(px,py,2+alpha*2,{col[1],col[2],col[3],alpha*0.9},6)
        elseif e.type=="vfx" and sg("bs_hit_vfx") then
            local dt2=now-e.born local px=e.sx+e.vx*dt2 local py=e.sy+e.vy*dt2
            local sz=(e.size or 3)*(1-age*0.5) local col=e.col
            draw.CircleFilled(px,py,sz+3,{col[1],col[2],col[3],alpha*0.25},8)
            draw.CircleFilled(px,py,sz,{col[1],col[2],col[3],alpha*0.85},8)
        end
    end
end

