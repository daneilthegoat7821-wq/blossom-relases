local function w_slider(it,x,y,w,ap)
    local top=BASE_ROW.slider
    local val=ui.vals[it.id]
    local scale=it.scale or 1
    local num=it.float and string.format(it.fmt,val*scale) or string.format(it.fmt or "%d",val)
    local disp=num..(it.suffix or "")
    tmid(x,y,16,it.label, a(theme.text,ap*0.9),13)
    tright(x+w,y,16,disp, a(theme.accent,ap),12)
    local tx,ty,tw,th=x,y+21,w,4
    local target=(val-it.min)/(it.max-it.min)
    -- grab zone spans the whole control band (label row through track), full width
    local hot=inside(x,y,w,top-2) and interactable(ap)
    if hot and ui.mouse.clicked and not ui.drag then
        ui.drag={kind="slider",id=it.id,min=it.min,max=it.max,x=tx,w=tw}
    end
    if ui.drag and ui.drag.kind=="slider" and ui.drag.id==it.id then
        local f=clamp((ui.mouse.x-tx)/tw,0,1)
        ui.vals[it.id]=math.floor(it.min+f*(it.max-it.min)+0.5); target=f
    end
    local fill=approach("sl_"..it.id, target, 18)
    draw.RectFilled(tx,ty,tw,th, a(theme.rail,ap), th*0.5)
    if fill>0.001 then
        local fw=math.max(th,tw*fill)
        soft(tx,ty,fw,th,theme.accent,th*0.5,2,ap*0.7)
        if theme.grad then draw.RectFilled(tx,ty,fw,th, a(mix(theme.accent,theme.accent2,0.5),ap), th*0.5)
        else draw.RectFilled(tx,ty,fw,th, a(theme.accent,ap), th*0.5) end
    end
    local hv=approach("slh_"..it.id, hot and 1 or 0, 14)
    draw.CircleFilled(tx+tw*fill, ty+th*0.5, 5+hv*1.5, a({1,1,1,1},ap),24)
    return top + desc(it,x,y+top-4,w,ap)
end

