                            if ok2 and parts then
                                for _, part in ipairs(parts) do
                                    if part:IsA("BasePart") then
                                        local pos = part.position
                                        if pos then
                                            local dist = get_dist(pos.x,pos.y,pos.z,cx,cy,cz)
                                            if dist <= rng then
                                                if show_hl then world_get_hl(part) end
                                                local sx,sy,vis = draw.WorldToScreen(pos.x,pos.y,pos.z)
                                                if vis then
                                                    draw.Circle(sx,sy,10,{c[1],c[2],c[3],0.9},16,2)
                                                    draw.CircleFilled(sx,sy,4,{c[1],c[2],c[3],0.7},8)
