-- =============================================================
LEGIT_OVERSHOOT_X = 0
LEGIT_OVERSHOOT_Y = 0
LEGIT_CORRECTING  = false

local function run_legit_aim()
    if not ui.vals["legit_on"] then return end
    local lkey = ui.binds["legit_key"] or 0x02
    if not input.IsKeyDown(lkey) then
        LEGIT_OVERSHOOT_X=0; LEGIT_OVERSHOOT_Y=0; LEGIT_CORRECTING=false
        return
    end
    local sw,sh = draw.GetScreenSize()
    local scx,scy = sw*0.5, sh*0.5
    local players = entity.GetPlayers()
    if not players then return end
    local fov_lim = fvn("legit_fov") or 100
    local smooth  = math.max(1, fvn("legit_smooth") or 30)
    local jitter  = fvn("legit_jitter") or 2
    local oversh  = fvn("legit_overshoot") or 5
    local vis_only= ui.vals["legit_vis"]

    local best_fov = fov_lim
    local best_bx,best_by = scx,scy

    for _,p in ipairs(players) do
        if p.IsLocal or not p.IsValid or not p.IsAlive then goto lcont end
        if vis_only then
            local vis=false
            pcall(function() if p.Character then vis=raycast.IsPlayerVisible(p.Character) end end)
            if not vis then goto lcont end
        end
        local bx,by,bv = p:GetBoneScreen("Head")
        if bv then
            local fov=math.sqrt((bx-scx)^2+(by-scy)^2)
            if fov<best_fov then best_fov=fov; best_bx=bx; best_by=by end
        end
        ::lcont::
    end

    if best_fov >= fov_lim then return end

    -- Delta to target
    local dx = best_bx - scx + LEGIT_OVERSHOOT_X
    local dy = best_by - scy + LEGIT_OVERSHOOT_Y

    -- Add micro-jitter
    if jitter > 0 then
        local t2=ib_clock()
        dx = dx + math.sin(t2*37.3)*jitter
        dy = dy + math.cos(t2*29.7)*jitter
    end

    -- Smoothed move
    local spd = math.max(1, 51-smooth)
    local mx = dx/spd
    local my = dy/spd

    -- Humanizer tremor
    if ui.vals["humanizer_on"] then
        local hs = fvn("humanizer_str") or 2
        local t3 = ib_clock()
        mx = mx + (math.random()*2-1)*hs*0.3
        my = my + (math.random()*2-1)*hs*0.3
    end

    input.MoveMouse(mx, my)

    -- Overshoot: occasionally move past the target and correct
    if oversh>0 and math.random(100)<3 then
        LEGIT_OVERSHOOT_X = (math.random()*2-1)*oversh
        LEGIT_OVERSHOOT_Y = (math.random()*2-1)*oversh
    else
        LEGIT_OVERSHOOT_X = LEGIT_OVERSHOOT_X * 0.85
        LEGIT_OVERSHOOT_Y = LEGIT_OVERSHOOT_Y * 0.85
    end
end

