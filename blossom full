-- =========================================================
-- COLOR / EASING / HSV
-- =========================================================
local function a(c, alpha) return { c[1], c[2], c[3], (c[4] or 1) * alpha * theme.opacity } end
local function raw(c, alpha) return { c[1], c[2], c[3], (c[4] or 1) * alpha } end
local function mix(c1, c2, t)
    return { c1[1]+(c2[1]-c1[1])*t, c1[2]+(c2[2]-c1[2])*t,
             c1[3]+(c2[3]-c1[3])*t, (c1[4] or 1)+((c2[4] or 1)-(c1[4] or 1))*t }
end
local function clamp(v, lo, hi) return v<lo and lo or (v>hi and hi or v) end
local function ease_out(t) t=clamp(t,0,1); local f=1-t; return 1-f*f*f end
local function ease_back(t) t=clamp(t,0,1); local s=1.55; local f=t-1; return 1+(s+1)*f*f*f+s*f*f end

-- HSV(0..1) -> RGB(0..1)
local function hsv(h, s, v)
    h = (h % 1) * 6
    local i = math.floor(h)
    local f = h - i
    local p = v*(1-s)
    local q = v*(1-s*f)
    local u = v*(1-s*(1-f))
    if     i==0 then return {v,u,p,1}
    elseif i==1 then return {q,v,p,1}
    elseif i==2 then return {p,v,u,1}
    elseif i==3 then return {p,q,v,1}
    elseif i==4 then return {u,p,v,1}
    else            return {v,p,q,1} end
end
-- RGB -> HSV
local function to_hsv(c)
    local r,g,b = c[1],c[2],c[3]
    local mx = math.max(r,g,b); local mn = math.min(r,g,b)
    local d = mx-mn
    local h = 0
    if d>0 then
        if mx==r then h=((g-b)/d) % 6
        elseif mx==g then h=(b-r)/d+2
        else h=(r-g)/d+4 end
        h = h/6
    end
    local s = mx==0 and 0 or d/mx
    return h, s, mx
end

-- =========================================================
-- ANIMATION REGISTRY
-- =========================================================
anim = {}
_dt = 0  -- cached delta time, updated once per frame
local function approach(key, target, speed)
    local v = anim[key]; if v==nil then v=target end
    v = v + (target-v) * clamp(_dt*(speed or 12)*theme.anim, 0, 1)
    anim[key] = v; return v
end

