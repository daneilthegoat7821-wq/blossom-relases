local function draw_columns(tab,ox,alpha,t)
    local cx=ui.x+ui.railw+theme.pad+ox
    local cy=ui.y+theme.pad+26
    local cw=ui.w-ui.railw-theme.pad*2-8
    local ch=ui.h-theme.pad*2-26
    local right_edge=ui.x+ui.w-theme.pad
    local ncols=4
    local colw=(cw-theme.gutter*(ncols-1))/ncols
    local scroll=ui.scroll[ui.tab] or 0
    local coly={cy-scroll,cy-scroll,cy-scroll,cy-scroll}
    local colx={
        cx,
        cx+colw+theme.gutter,
        cx+(colw+theme.gutter)*2,
        cx+(colw+theme.gutter)*3,
    }
    local gi=0
    for _,g in ipairs(tab.groups) do
        gi=gi+1
        local col=g.col or 1
        local gx,gy=colx[col],coly[col]
        local gh=group_h(g)
        local since=t-ui.tab_time
        local delay=(gi-1)*0.035
        local ap=ease_out(clamp((since-delay)/0.30,0,1))*alpha
        local slide=(1-ap)*10
        local draw_y=gy+slide
        local eff_w=math.min(colw,right_edge-gx)
        local ok_x=(gx<right_edge) and (eff_w>10)
        local ok_y=(draw_y+gh>cy) and (draw_y<cy+ch)
        if ok_x and ok_y then
            local vis_top=math.max(draw_y,cy)
            local vis_h=math.min(draw_y+gh,cy+ch)-vis_top
            if vis_h>0 then
                soft(gx,vis_top,eff_w,vis_h,_BLK_FULL,theme.round,3,ap*0.35)
                draw.RectFilled(gx,draw_y,eff_w,gh,a(theme.panel,ap),theme.round)
                draw.Rect(gx,draw_y,eff_w,gh,a(theme.line,ap),theme.round,1)
                if draw_y>=cy-28 and draw_y<cy+ch then
                    draw.RectFilled(gx,draw_y,eff_w,28,a(theme.panel_hi,ap),theme.round)
                    draw.RectFilled(gx,draw_y+28-theme.round,eff_w,theme.round,a(theme.panel_hi,ap))
                    draw.RectFilled(gx+12,draw_y+9,2,10,a(theme.accent,ap),1)
                    tmid(gx+20,draw_y,28,g.name,a(theme.text,ap),12)
                    draw.Line(gx,draw_y+28,gx+eff_w,draw_y+28,a(theme.line,ap),1)
                end
                local iw=eff_w-28
                local iy=draw_y+36
                for j,it in ipairs(g.items) do
                    local ih=row_h(it)
                    if iy+ih>cy and iy<cy+ch then
                        W[it.t](it,gx+14,iy,iw,ap)
                        if j<#g.items and it.t~="sep" then
                            draw.Line(gx+14,iy+ih-1,gx+eff_w-14,iy+ih-1,a(theme.line,ap*0.55),1)
                        end
                    end
                    iy=iy+ih
                    if iy>cy+ch+4 then break end
                end
            end
        end
        coly[col]=gy+gh+theme.gutter
    end

    local total = math.max(coly[1],coly[2],coly[3],coly[4]) - (cy - scroll)

    -- Cover top/bottom bleed with menu background color
    -- base_col computed once per call
    local bc1,bc2,bc3,bc4 = theme.base[1],theme.base[2],theme.base[3],1
    -- Top mask (covers anything above cy)
    draw.RectFilled(ui.x+ui.railw, ui.y, ui.w-ui.railw, theme.pad+26+1, {bc1,bc2,bc3,bc4})
    -- Bottom mask (covers anything below cy+ch)
    draw.RectFilled(ui.x+ui.railw, cy+ch, ui.w-ui.railw, ui.h-(cy+ch-ui.y)+1, _MASK_COL)

    return total
end

