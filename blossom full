-- resolve a themecolor field to its live color table
local function get_field_color(field)
    if theme[field] then return theme[field] end
    return ui.colors[field]
end
local function set_field_color(field, c)
    if theme[field] then theme[field] = c else ui.colors[field] = c end
end

-- =========================================================
-- HELPERS
-- =========================================================
local function inside(x,y,w,h)
    local m=ui.mouse
    return m.x>=x and m.x<=x+w and m.y>=y and m.y<=y+h
end
local function tsize(s,sz) return draw.GetTextSize(s, sz or 12) end
local function tmid(x,y,h,s,col,sz) sz=sz or 12; local _,th=tsize(s,sz); draw.Text(x,y+(h-th)*0.5,s,col,sz) end
local function tright(xr,y,h,s,col,sz) sz=sz or 12; local tw,th=tsize(s,sz); draw.Text(xr-tw,y+(h-th)*0.5,s,col,sz); return tw end
local function soft(x,y,w,h,col,r,spread,strength)
    spread = math.floor(spread*theme.glow + 0.5)
    for i=spread,1,-1 do
        local f=i/spread
        draw.RectFilled(x-i,y-i,w+i*2,h+i*2, raw(col, strength*(1-f)*0.5*theme.opacity), r+i)
    end
end
-- horizontal gradient strip via vertical slices
local function grad_h(x,y,w,h,c1,c2,steps)
    steps = steps or 24
    local sw = w/steps
    for i=0,steps-1 do
        draw.RectFilled(x+i*sw, y, sw+1, h, mix(c1,c2,i/(steps-1)), 0)
    end
end

-- =========================================================
-- ROW HEIGHTS
-- =========================================================
local BASE_ROW = { toggle=26, hudtoggle=26, slider=32, combo=28, bind=26,
                   themecolor=26, button=30, note=18, sep=10, swatches=34,
                   stat=22, input_ro=42, preview=176 }
local function row_h(it)
    local h = BASE_ROW[it.t] or 24
    if it.d then h = h + 13 end
    return h
end
local function group_h(g)
    local h=34
    for _,it in ipairs(g.items) do h=h+row_h(it) end
    return h+10
end

-- =========================================================
-- WIDGETS
-- =========================================================
-- full clickable height of a row = control band + description line (if any)
local function hit_h(it, top) return top + (it.d and 13 or 0) end
-- a control accepts input only when its card is essentially settled and no modal is open
local function interactable(ap) return ap>0.9 and not ui.popup and not ui.picker end

local function desc(it,x,y,w,ap)
    if not it.d then return 0 end
    tmid(x,y,13,it.d, a(theme.faint,ap),10); return 13
end

local function w_toggle(it,x,y,w,ap)
    local top=BASE_ROW.toggle
    local val=ui.vals[it.id]
    local hot=inside(x,y,w,hit_h(it,top)) and interactable(ap)
    if hot and ui.mouse.clicked then
        if it.locked and val then log("'"..it.label.."' locked ON. Nice try.")
        else ui.vals[it.id]=not val; log(it.label.." -> "..tostring(not val).." (visual only)") end
    end
    local hv=approach("th_"..it.id, hot and 1 or 0, 14)
    tmid(x,y,top,it.label, a(mix(theme.text,{1,1,1,1},hv*0.25), ap*(0.86+hv*0.14)),13)
    local pw,ph=34,16
    local px,py=x+w-pw,y+(top-ph)*0.5
    local rv=approach("tg_"..it.id, val and 1 or 0, 16)
    local sp=ease_back(rv)
    if rv>0.02 then soft(px,py,pw,ph,theme.accent,ph*0.5,3,rv*ap) end
    if theme.grad and rv>0.02 then
        draw.RectFilled(px,py,pw,ph, a(mix(theme.field,theme.accent,rv),ap), ph*0.5)
    else
        draw.RectFilled(px,py,pw,ph, a(mix(theme.field,theme.accent,rv),ap), ph*0.5)
    end
    if rv<0.5 then draw.Rect(px,py,pw,ph, a(theme.rail, ap*(1-rv*2)), ph*0.5,1) end
    local kr=(ph-6)*0.5
    draw.CircleFilled(px+3+kr+(pw-ph)*sp, py+ph*0.5, kr, a(mix({0.75,0.76,0.80,1},{1,1,1,1},rv),ap),24)
    return top + desc(it,x,y+top-2,w,ap)
end

