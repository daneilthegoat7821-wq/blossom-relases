-- =============================================================
-- CHARACTER OVERLAY — Highlight-based skin system
-- =============================================================
-- The VM doesn't support writing TextureID on MeshParts directly.
-- What it DOES support: instance.New("Highlight", char).
-- Highlight is a Roblox object that tints the entire character
-- with a fill color + outline color. We assign each character
-- a unique color combo so they look visually distinct.
-- Self = your own character gets a custom tint.
-- Others = all enemies get a different tint.
-- This is the correct overlay path for this VM.

-- Each character def has: fill color {r,g,b}, outline color {r,g,b},
-- fill transparency (0=solid, 1=invisible), and display name.
CO_CHARS = {
    [1] = { name="None" },
    [2] = { name="Goku",
            fill={0.18,0.36,0.90},  -- deep blue (Goku gi)
            fill2={0.95,0.85,0.10}, -- gold (Super Saiyan aura)
            trans=0.3 },
    [3] = { name="Tongue Tongue Sahur",
            fill={0.60,0.10,0.80},  -- dark purple (creature vibe)
            fill2={1.0,0.0,0.4},    -- hot pink outline
            trans=0.2 },
    [4] = { name="Scary Creature",
            fill={0.05,0.05,0.05},  -- near-black body
            fill2={0.8,0.0,0.0},    -- blood red outline
            trans=0.1 },
}

-- Cache: key=tostring(char), val={hl=Highlight instance, char=char, applied_idx}
CO_SELF_CACHE   = { char=nil, hl=nil, applied=0 }
CO_OTHERS_CACHE = {}

local function co_apply_highlight(char, def, cache_entry)
    -- Get or create Highlight on this char
    local hl = cache_entry.hl
    if not hl or not pcall(function() return hl.Parent end) then
        pcall(function()
            local existing = char:FindFirstChildOfClass("Highlight")
            if existing then hl = existing
            else hl = instance.New("Highlight", char) end
        end)
        cache_entry.hl = hl
    end
end

local function co_remove_highlight(cache_entry)
    if cache_entry and cache_entry.hl then
        pcall(function() instance.Destroy(cache_entry.hl) end)
        cache_entry.hl      = nil
        cache_entry.applied = 0
    end
end

local function run_character_overlay()
    -- Fast exit when both features off — avoids entity.GetPlayers() call
    local self_on   = ui.vals["co_self_on"]
    local others_on = ui.vals["co_others_on"]
    if not self_on and not others_on then
        -- Clean up any lingering highlights once
        if CO_SELF_CACHE.applied ~= 0 then co_remove_highlight(CO_SELF_CACHE); CO_SELF_CACHE.char=nil end
        return
    end

    local self_idx = math.floor(tonumber(fvn("co_self_char")) or 1)
    local lp       = entity.GetLocalPlayer()
    local self_char= lp and lp.Character

    if self_on and self_idx > 1 and self_char then
        local def = CO_CHARS[self_idx]
        -- Char changed (respawn) — clear old highlight
        if CO_SELF_CACHE.char ~= self_char then
            co_remove_highlight(CO_SELF_CACHE)
            CO_SELF_CACHE.char = self_char
        end
        -- Apply if not already applied with this def
        if CO_SELF_CACHE.applied ~= self_idx then
            co_remove_highlight(CO_SELF_CACHE)
            co_apply_highlight(self_char, def, CO_SELF_CACHE)
            CO_SELF_CACHE.applied = self_idx
        end
    else
        -- Off or None — remove once
        if CO_SELF_CACHE.applied ~= 0 then
            co_remove_highlight(CO_SELF_CACHE)
            CO_SELF_CACHE.char = nil
        end
    end

    -- ── OTHERS ───────────────────────────────────────────────
    local others_on  = ui.vals["co_others_on"]
    local others_idx = math.floor(tonumber(fvn("co_others_char")) or 1)
    local players    = entity.GetPlayers()
    if not players then return end

    local seen = {}
    for _, p in ipairs(players) do
        if p.IsLocal then goto ocont end
        if not p.IsValid then goto ocont end
        local char = p.Character
        if not char then goto ocont end

        local key = tostring(char)
        seen[key] = true

        local entry = CO_OTHERS_CACHE[key]
        if not entry then
            entry = { char=char, hl=nil, applied=0 }
            CO_OTHERS_CACHE[key] = entry
        end

        if others_on and others_idx > 1 then
            local def = CO_CHARS[others_idx]
            if entry.applied ~= others_idx then
                co_remove_highlight(entry)
                co_apply_highlight(char, def, entry)
                entry.applied = others_idx
            end
        else
            if entry.applied ~= 0 then
                co_remove_highlight(entry)
            end
        end
        ::ocont::
    end

    -- Clean up highlights for players who left
    for key, entry in pairs(CO_OTHERS_CACHE) do
        if not seen[key] then
            co_remove_highlight(entry)
            CO_OTHERS_CACHE[key] = nil
        end
    end
end

-- =============================================================
-- KD FIXER — AFK auto-respawn for Project Delta
-- =============================================================
-- Uses entity.GetLocalPlayer() which exposes IsDead and Health
-- directly via the VM's entity system — no Humanoid scanning,
-- no RemoteEvent fishing. To respawn we use setgc("Dead", false)
-- which patches the Humanoid dead state in the GC, plus a direct
-- health write via lp.Health — both are VM-native operations.
KDF_STATE      = "alive"  -- "alive" | "dead_wait" | "fire"
KDF_DEATH_T    = 0
KDF_FIRE_T     = 0        -- cooldown after firing so we don't spam

local function run_kd_fixer()
    if not ui.vals["kdf_on"] then
        KDF_STATE = "alive"
        return
    end

    local lp    = entity.GetLocalPlayer()
    if not lp then return end

    local now   = utility.GetTime()
    local delay = clamp(tonumber(fvn("kdf_delay")) or 2, 1, 10)

    if KDF_STATE == "alive" then
        -- Detect death via the entity system's IsDead flag
        -- or Health dropping to zero
        local dead = lp.IsDead or (lp.Health or 1) <= 0
        if dead then
            KDF_STATE   = "dead_wait"
            KDF_DEATH_T = now
            if ui.vals["kdf_notify"] then
                notify.Warning("KD Fixer", "Death detected — respawning in " .. delay .. "s", 3)
            end
        end

    elseif KDF_STATE == "dead_wait" then
        if (now - KDF_DEATH_T) >= delay then
            -- Fire respawn: patch the Dead flag via GC + restore health
            -- setgc walks ALL lua tables and flips Dead=false — this is
            -- how the humanoid's death state is held in Project Delta
            pcall(function() setgc("Dead", false) end)
            pcall(function() applygc("Dead", false) end)
            -- Also write health directly through the entity system
            pcall(function()
                lp.Health    = lp.MaxHealth or 100
            end)
            -- Also try the standard Roblox respawn path as backup
            pcall(function()
                local glp = game.LocalPlayer
                if glp then glp:LoadCharacter() end
            end)
            KDF_STATE  = "fire"
            KDF_FIRE_T = now
        end

    elseif KDF_STATE == "fire" then
        -- Give the respawn 5 seconds to land
        local alive = (lp.IsAlive == true) or ((lp.Health or 0) > 0 and not lp.IsDead)
        if alive then
            KDF_STATE = "alive"
            if ui.vals["kdf_notify"] then
                notify.Success("KD Fixer", "Respawned!", 2)
            end
        elseif (now - KDF_FIRE_T) > 5 then
            -- Didn't come back — retry
            KDF_STATE   = "dead_wait"
            KDF_DEATH_T = now
        end
    end
end

-- =============================================================
-- THIRD PERSON — render-tick camera write
-- =============================================================
-- This runs at the END of on_frame, after all game logic.
-- on_frame IS the render callback in this VM — firing here is
-- equivalent to RenderStepped priority in standard Roblox Lua.
-- Writing at render time means we always win: game logic already
-- ran, camera hasn't drawn yet. No race. No fight. No jitter.
--
-- Method: CurrentCamera.CFrame written every render tick.
-- We build a CFrame that sits dist studs behind and 2 studs above
-- the HumanoidRootPart, looking at the character's head height.
-- The full body is visible in frame because the camera is placed
-- where the player physically was standing — they look AT themselves.
-- No CameraOffset (it fights physics), no CameraType override
-- (anti-cheat surface). Pure CFrame write at the right moment.
TP_CAM_WAS = false  -- true while we own the camera CFrame

local function run_third_person()
    if not sg("pl_third") then
        -- Restore Roblox's camera controller once on toggle-off
        if TP_CAM_WAS then
            TP_CAM_WAS = false
            pcall(function()
                local lp = game.LocalPlayer
                if not lp or not lp.Character then return end
                local hum = lp.Character:FindFirstChild("Humanoid")
                if hum then hum.CameraOffset = Vector3.New(0, 0, 0) end
                -- Let Roblox take back the camera by zeroing our state.
                -- We don't change CameraType — we never touched it.
            end)
        end
        return
    end

    pcall(function()
        local lp   = game.LocalPlayer
        if not lp or not lp.Character then return end
        local char = lp.Character
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        -- Distance from slider, clamped
        local dist = clamp(tonumber(fvn("bs_tp_dist")) or 10, 4, 30)

        -- Get root position
        local rpos = root.Position
        local rx, ry, rz = rpos.X, rpos.Y, rpos.Z

        -- Get camera look vector for horizontal facing direction.
        -- Flatten to XZ so we don't pitch-dive into the ground.
        local look = camera.GetLookVector()
        local lx   = look.X or 0
        local lz   = look.Z or 0
        local hlen = math.sqrt(lx*lx + lz*lz)
        if hlen > 0.001 then
            lx = lx / hlen
            lz = lz / hlen
        else
            lx, lz = 0, 1
        end

        -- Camera sits dist studs directly behind the character
        -- on the horizontal plane, raised 2 studs for over-shoulder feel.
        -- "Behind" = opposite of look direction.
        local camx = rx - lx * dist
        local camy = ry + 2.0
        local camz = rz - lz * dist

        -- Look target: character upper torso / head area so the body
        -- stays centered and visible in frame.
        local tgx, tgy, tgz = rx, ry + 1.5, rz

        -- Build forward vector from cam to target
        local fdx = tgx - camx
        local fdy = tgy - camy
        local fdz = tgz - camz
        local flen = math.sqrt(fdx*fdx + fdy*fdy + fdz*fdz)
        if flen < 0.001 then return end
        fdx = fdx / flen
        fdy = fdy / flen
        fdz = fdz / flen

        -- World up
        local ux, uy, uz = 0, 1, 0

        -- Right vector = forward cross up
        local rx2 = fdy*uz - fdz*uy
        local ry2 = fdz*ux - fdx*uz
        local rz2 = fdx*uy - fdy*ux
        local rlen = math.sqrt(rx2*rx2 + ry2*ry2 + rz2*rz2)
        if rlen < 0.001 then return end
        rx2 = rx2/rlen; ry2 = ry2/rlen; rz2 = rz2/rlen

        -- Recompute up = right cross forward (orthonormal basis)
        local ux2 = ry2*fdz - rz2*fdy
        local uy2 = rz2*fdx - rx2*fdz
        local uz2 = rx2*fdy - ry2*fdx

        -- Build CFrame from basis vectors + position.
        -- CFrame row-major: right, up, -forward (Roblox convention).
        local cf = CFrame.new(
            camx, camy, camz,
            rx2,  ux2, -fdx,
            ry2,  uy2, -fdy,
            rz2,  uz2, -fdz
        )

        -- Write to workspace camera — at render tick this wins cleanly.
        local ws = game.Workspace
        if not ws then return end
        local wcam = ws.CurrentCamera or ws.currentCamera
        if not wcam then return end
        wcam.CFrame = cf
        TP_CAM_WAS  = true
    end)
end

-- =============================================================
-- ON_FRAME — UI + all features
-- =============================================================
function on_frame()
    local t=utility.GetTime()
    _dt = utility.GetDeltaTime()  -- cache once per frame for approach()
    theme.round   = ui.vals["st_round"] or theme.round
    theme.pad     = ui.vals["st_pad"]   or theme.pad
    theme.gutter  = ui.vals["st_gutter"]or theme.gutter
    theme.opacity = (ui.vals["st_opac"] or 100)/100
    theme.anim    = (ui.vals["st_anim"] or 100)/100
    theme.glow    = (ui.vals["st_glow"] or 100)/100
    theme.grad    = ui.vals["th_grad"]

    local mx,my=utility.GetMousePos()
    local down=input.IsKeyDown(0x01)
    ui.mouse.x,ui.mouse.y=mx,my
    ui.mouse.clicked=down and not ui.mouse.was
    ui.mouse.down,ui.mouse.was=down,down
    if not down then ui.drag=nil end

    local mk=ui.binds["st_menukey"] or 0x2D
    if mk~=0 then
        local held=input.IsKeyDown(mk)
        if held and not ui.menu_edge then ui.open=not ui.open; ui.popup=nil; ui.capture=nil; ui.picker=nil end
        ui.menu_edge=held
    end

    -- Always-on features
    pcall(poll_keybinds)
    pcall(run_weapon_mods)
    pcall(run_movement)
    pcall(run_arm_glow)
    pcall(run_character_overlay)
    pcall(run_hit_detection)
    pcall(esp_kill_tracker)
    pcall(run_silent_aim)
    pcall(run_rage_aimbot)
    pcall(run_legit_aim)
    pcall(run_npc_aimbot)
    pcall(run_world_fx)
    pcall(draw_world_esp)
    pcall(draw_npcs_esp)
    pcall(draw_players_esp)
    pcall(run_orbit_vfx)
    pcall(draw_hit_effects)
    pcall(run_kd_fixer)
    pcall(run_bunnyhop)
    pcall(run_autostrafe)
    pcall(run_teleports)
    pcall(run_anti_afk)
    pcall(run_auto_reload)
    pcall(update_kill_counter)
    pcall(update_damage_numbers)

    -- Always-draw UI elements
    draw_topbar(t)
    draw_hud(t)
    if ui.drag and ui.drag.kind=="hud" then
        local wg=hud[ui.drag.key]
        if wg then wg.x=ui.mouse.x-ui.drag.ox wg.y=ui.mouse.y-ui.drag.oy end
    end
    draw_overlays(t)
    pcall(draw_crosshair)
    pcall(draw_mod_alert)
    pcall(draw_watermark)

    -- Menu UI
    ui.appear=approach("appear", ui.open and 1 or 0, 14)

    -- Disclaimer gates everything — show it first, then UI
    if not ui.disclaimer_accepted then
        if ui.vals["_disc_declined"] then return end  -- declined, show nothing
        draw_disclaimer()
        return
    end

    if ui.appear<0.01 then return end
    capture()
    search_typing()
    if not ui.picker then popup_input() end
    if ui.drag and ui.drag.kind=="window" then
        local sw,sh=utility.GetScreenSize()
        ui.x=clamp(ui.mouse.x-ui.drag.ox,0,sw-ui.w)
        ui.y=clamp(ui.mouse.y-ui.drag.oy,0,sh-ui.h)
    end
    local e=ease_out(ui.appear)
    local rise=(1-e)*14
    local oy=ui.y ui.y=ui.y+rise
    local saved=theme.opacity theme.opacity=theme.opacity*e
    soft(ui.x,ui.y,ui.w,ui.h,_BLK_FULL,theme.round,9,0.55)
    draw.RectFilled(ui.x-1,ui.y-1,ui.w+2,ui.h+2, a(theme.line,1),theme.round+1)
    draw.RectFilled(ui.x,ui.y,ui.w,ui.h, a(theme.base,1),theme.round)
    draw.RectFilled(ui.x+theme.round,ui.y,ui.w-theme.round*2,1, a(theme.accent,0.4))
    draw_rail(t)
    draw_content(t)
    popup_draw()
    picker_draw_and_input()
    ui.y=oy theme.opacity=saved

    -- Third person: runs LAST, after all game logic and UI draws.
    -- At this point in on_frame the engine has processed physics and
    -- game camera logic for this tick. Our CFrame write lands here and
    -- is what the renderer actually uses — no competition, no race.
    pcall(run_third_person)

    -- HUD overlays draw LAST — always on top of everything.
    -- Hidden when menu is open to avoid overlapping the UI panels.
    if not ui.open then
        pcall(draw_radar)
        pcall(draw_damage_numbers)
        pcall(draw_feature_bar)
        pcall(draw_kill_counter)
        pcall(draw_keybind_display)
    else
        -- When menu open: only draw damage numbers (they're floating world-space, fine to show)
        pcall(draw_damage_numbers)
        pcall(draw_feature_bar)  -- compact pill bar — draw even with menu open, stays at bottom
    end
end

