    local sc    = ui.colors["_radar_s"] or {0.3,1,0.5,1}

    -- Background
    _RADAR_BG[4]=ral*0.75; draw.RectFilled(rx,ry,rsz,rsz,_RADAR_BG,theme.round-2)
    _RADAR_GRD[4]=ral*0.15; draw.Rect(rx,ry,rsz,rsz,_RADAR_GRD,0,1)

    -- Cross lines
    local cx2=rx+rsz*0.5; local cy2=ry+rsz*0.5
    _RADAR_GRD[4]=ral*0.1; draw.Line(cx2,ry+2,cx2,ry+rsz-2,_RADAR_GRD,1)
    draw.Line(rx+2,cy2,rx+rsz-2,cy2,_RADAR_GRD,1)

    -- Self dot
    draw.CircleFilled(cx2,cy2,4,{sc[1],sc[2],sc[3],ral})
    draw.Circle(cx2,cy2,4,{0,0,0,ral*0.5},8,1)

    -- Get camera look vector for rotation
    local look = camera.GetLookVector()
    local lyaw = look and math.atan2(look.X or 0, look.Z or 0) or 0

    local me = entity.GetLocalPlayer()
    local mpos = me and me.Position
    if not mpos then return end

    local players = entity.GetPlayers()
    if not players then return end

    for _,p in ipairs(players) do
        if p.IsLocal or not p.IsValid or not p.IsAlive then goto rcont end
        local pos = p.Position
        if pos then
            local dx = pos.X - mpos.X
            local dz = pos.Z - mpos.Z
            local dist = math.sqrt(dx*dx+dz*dz)
            if dist <= rng then
                -- Rotate to camera facing
                local angle = math.atan2(dx,dz) - lyaw
                local ndist = dist/rng
                local px = cx2 + math.sin(angle)*ndist*(rsz*0.5-6)
                local py = cy2 + math.cos(angle)*ndist*(rsz*0.5-6)
                -- Dot
                draw.CircleFilled(px,py,3,{ec[1],ec[2],ec[3],ral})
                draw.Circle(px,py,3,{0,0,0,ral*0.5},8,1)
            end
        end
        ::rcont::
    end

    -- Label
    draw.Text(rx+4, ry+rsz-14, "RADAR", {1,1,1,ral*0.4}, 9)
end

