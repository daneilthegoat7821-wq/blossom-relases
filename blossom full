-- HUD WIDGETS  (draggable, cosmetic, fake data)
-- =========================================================
local function hud_panel(wg, key, t)
    if not wg.on then return end
    local x,y,w = wg.x, wg.y, wg.w
    local alpha = (ui.vals["hud_alpha"] or 92)/100
    local accent_title = ui.vals["hud_accenttitle"]

    -- measure height by content type
    local rows = 0
    if key=="boss" then rows = 2 + #wg.rows + 1 + #wg.vehicles
    elseif key=="loot" then rows = #wg.rows
    elseif key=="card" then rows = 2
    elseif key=="status" then rows = 2 + #wg.items end
    local header=26
    local body = (key=="boss") and (14 + #wg.rows*15 + 16 + #wg.vehicles*15 + 8)
              or (key=="status") and (34 + #wg.items*15 + 8)
              or (key=="loot") and (10 + #wg.rows*16 + 8)
              or (key=="card") and 44
              or 40
    local h = header + body

    soft(x,y,w,h,_BLK_FULL, theme.round, 3, alpha*0.6)
    draw.RectFilled(x,y,w,h, raw(theme.base, 0.96*alpha), theme.round)
    draw.Rect(x,y,w,h, raw(theme.line, alpha), theme.round, 1)
    -- header
    local htcol = accent_title and theme.accent or theme.panel_hi
    draw.RectFilled(x,y,w,header, raw(htcol, accent_title and (0.9*alpha) or alpha), theme.round)
    draw.RectFilled(x,y+header-theme.round,w,theme.round, raw(htcol, accent_title and (0.9*alpha) or alpha))
    tmid(x+12,y,header, wg.title, raw(accent_title and {1,1,1,1} or theme.text, 0.95),12)
    tright(x+w-10,y,header,"drag ::", raw({1,1,1,1}, 0.5),9)

    -- drag by header
    if inside(x,y,w,header) and ui.mouse.clicked and not ui.drag then
        ui.drag={kind="hud", key=key, ox=ui.mouse.x-x, oy=ui.mouse.y-y}
        ui.mouse.clicked=false
    end

    local iy = y+header+6
    if key=="boss" then
        tmid(x+12,iy,14,"BOSSES", raw(theme.faint,0.9),9); iy=iy+15
        for _,r in ipairs(wg.rows) do
            tmid(x+12,iy,15,r[1], raw(theme.text,0.9),11)
            tright(x+w-12,iy,15,r[2], raw(theme.sub,1),10); iy=iy+15
        end
        iy=iy+4
        tmid(x+12,iy,14,"VEHICLES", raw(theme.faint,0.9),9); iy=iy+15
        for _,r in ipairs(wg.vehicles) do
            tmid(x+12,iy,15,r[1], raw(theme.text,0.9),11)
            tright(x+w-12,iy,15,r[2], raw(theme.sub,1),10); iy=iy+15
        end
    elseif key=="loot" then
        iy=iy+2
        for _,r in ipairs(wg.rows) do
            tmid(x+12,iy,16,"> "..r[1], raw(theme.text,0.9),11)
            tright(x+w-12,iy,16,r[2], raw(theme.accent,1),10); iy=iy+16
        end
    elseif key=="card" then
        tmid(x+12,iy,14,"EQUIPPED", raw(theme.faint,0.9),9); iy=iy+15
        tmid(x+12,iy,16,wg.equipped, raw(theme.accent,1),13)
    elseif key=="status" then
        -- Live threat panel — shows highest-threat nearby enemy
        local threat_lvl = wg.threat_level or 0
        local tc = THREAT_COLORS and THREAT_COLORS[threat_lvl+1] or {0.5,0.5,0.5,1}
        -- Player name header
        tmid(x+12,iy,16, wg.player or "—", raw(theme.text,0.95),12); iy=iy+18
        -- Threat color bar
        draw.RectFilled(x+12,iy,w-24,5, raw(theme.field,1),3)
        local bar_frac = math.min(1, (wg.threat_level or 0) / 4)
        if bar_frac > 0 then
            draw.RectFilled(x+12,iy,(w-24)*bar_frac,5, raw(tc,1),3)
        end
        iy=iy+12
        -- Items (guns, armor, dist, etc)
        for _,it in ipairs(wg.items or {}) do
            tmid(x+12,iy,15,it, raw(theme.sub,1),11); iy=iy+15
        end
    end
end

