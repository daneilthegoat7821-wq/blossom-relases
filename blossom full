local XHAIR_ANGLE=0
local function draw_crosshair()
    if not fvb("xhair_on") then return end
    local scx,scy=input.GetScreenCenter()
    local sz=fvn("xhair_size") or 12 local gap=fvn("xhair_gap") or 4 local th=fvn("xhair_thick") or 2
    local layout=math.floor(fvn("xhair_layout") or 1)
    local col=ui.colors["_xhair"]  or {1,1,1,1}
    local col2=ui.colors["_xhair2"] or {1,0.42,0.65,1}
    local dcol=ui.colors["_xhdot"]  or {1,1,0.3,1}
    local t=ib_clock()
    if fvb("xhair_spin") then XHAIR_ANGLE=XHAIR_ANGLE+(fvn("xhair_spin_spd") or 5)*ib_dt() end
    local ang=XHAIR_ANGLE
    local dc=col if fvb("xhair_animate") then local lerp=(math.sin(t*3)*0.5+0.5) dc={col[1]+(col2[1]-col[1])*lerp,col[2]+(col2[2]-col[2])*lerp,col[3]+(col2[3]-col[3])*lerp,1} end
    local function rot(dx,dy) local c,s=math.cos(ang),math.sin(ang) return scx+c*dx-s*dy,scy+s*dx+c*dy end
    local outer=gap+sz
    if layout==1 then
        local x1,y1=rot(-outer,0) local x2,y2=rot(-gap,0) local x3,y3=rot(gap,0) local x4,y4=rot(outer,0)
        local x5,y5=rot(0,-outer) local x6,y6=rot(0,-gap) local x7,y7=rot(0,gap) local x8,y8=rot(0,outer)
        draw.Line(x1,y1,x2,y2,dc,th) draw.Line(x3,y3,x4,y4,dc,th)
        draw.Line(x5,y5,x6,y6,fvb("xhair_animate") and col2 or dc,th)
        draw.Line(x7,y7,x8,y8,fvb("xhair_animate") and col2 or dc,th)
    elseif layout==2 then
